node_modules

# Local Netlify folder
.netlify

# Environment variables — never commit real credentials
.env
.env.local
.env.*.local

# Supabase local state (generated by `supabase start`)
supabase/.temp
supabase/functions/.env

# Astro build output
dist

# Astro file-based sessions (local dev when NETLIFY_DEV=1)
.astro/session

# Local-only admin document uploads (docs/uploads/{profileId}/); keep folder in git
docs/uploads/*
!docs/uploads/.gitkeep

# Editor / OS
.DS_Store
*.pem

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
