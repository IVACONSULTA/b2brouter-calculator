---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/home.css';
---

<Layout title="Home">
  <main class="page-home landing">
    <div class="hero">
      <div class="badge">B2B Router Calculator</div>
      <h1>Welcome</h1>
      <p class="subtitle">
        Choose your portal to continue. Each portal has its own dedicated workspace
        tailored to your role.
      </p>

      <div class="portal-grid">
        <a href="/admin/login" class="portal-card admin">
          <div class="portal-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5"/>
              <path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <div class="portal-content">
            <h2>Admin Portal</h2>
            <p>Manage routes, configurations, pricing rules, and system settings.</p>
          </div>
          <div class="portal-arrow">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </a>

        <a href="/customer/login" class="portal-card customer">
          <div class="portal-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="4"/>
              <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
            </svg>
          </div>
          <div class="portal-content">
            <h2>Customer Portal</h2>
            <p>View your routes, calculate costs, and manage your account settings.</p>
          </div>
          <div class="portal-arrow">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      </div>
    </div>
  </main>
</Layout>

