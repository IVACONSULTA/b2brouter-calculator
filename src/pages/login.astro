---
import Layout from '../layouts/Layout.astro';
import { getSession, isAdminRole, canAccessUserPortal } from '../lib/session';
import { isDemoAuthMode } from '../lib/supabase';
import '../styles/pages/login.css';

const session = getSession(Astro.cookies);
const from = Astro.url.searchParams.get('from') ?? '';

if (session) {
  if (from === 'admin') {
    if (isAdminRole(session.role)) return Astro.redirect('/admin/dashboard');
    return Astro.redirect('/dashboard');
  }
  if (from === 'customer') {
    if (canAccessUserPortal(session.role)) return Astro.redirect('/dashboard');
    return Astro.redirect('/admin/dashboard');
  }
  return Astro.redirect(isAdminRole(session.role) ? '/admin/dashboard' : '/dashboard');
}

const errorMessages: Record<string, string> = {
  invalid_credentials:
    'Incorrect email or password, or no user in this Supabase project. Use Dashboard → Authentication to add or reset the user; locally run npm run seed:users if needed.',
  email_not_confirmed:
    'Confirm your email (check inbox), or change email confirmation under Supabase Auth settings.',
  missing_fields: 'Please enter your email and password.',
  session_expired: 'Your session has expired. Please sign in again.',
  unauthorized: 'You do not have access to that page.',
  wrong_portal:
    'This account does not match the portal you chose. Go back to the home page and open Admin or Customer portal as appropriate.',
  server_config:
    'Server misconfiguration: Supabase keys are incomplete on the host. Configure SUPABASE_URL and SUPABASE_ANON_KEY for all Netlify deploy contexts.',
  server_error: 'Something went wrong while signing in. Please try again.',
};

const errorKey = Astro.url.searchParams.get('error') ?? '';
const errorMsg = errorMessages[errorKey] ?? '';

// Dummy shortcut UI only in local dev when Supabase URL is missing / placeholder.
const isDemoMode = isDemoAuthMode();
---

<Layout title="Sign in">
  <main class="page-login login-page">
    <div class="login-card">

      <!-- Brand -->
      <div class="brand">
        <div class="brand-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5"/>
            <path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <div>
          <h1>PA Plan Advisor</h1>
          <p>Sign in to your account</p>
        </div>
      </div>

      <div class="divider"></div>

      <!-- Demo mode notice -->
      {isDemoMode && (
        <div class="demo-banner">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
          </svg>
          <div>
            <strong>Demo mode</strong> — Supabase is not connected yet.
            Use one of the emails below with any password.
          </div>
        </div>
      )}

      <!-- Error banner -->
      {errorMsg && (
        <div class="error-banner">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          {errorMsg}
        </div>
      )}

      <!-- Login form — POSTs to /api/auth/login with portal intent preserved -->
      <form action={`/api/auth/login${from ? `?from=${from}` : ''}`} method="POST" class="login-form" id="login-form">
        <div class="field">
          <label for="email">Email address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="you@company.com"
            autocomplete="email"
            required
          />
        </div>

        <div class="field">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="••••••••"
            autocomplete="current-password"
            required
          />
        </div>

        <button type="submit" class="btn-submit" id="btn-submit">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
            <polyline points="10 17 15 12 10 7"/>
            <line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
          <span class="btn-submit-text">Sign in</span>
        </button>
      </form>

      <!-- Demo accounts helper (only shown in demo mode) -->
      {isDemoMode && (
        <div class="demo-accounts">
          <p class="demo-accounts-title">Demo accounts</p>
          <div class="demo-list">
            <button class="demo-btn" onclick="fillLogin('admin@b2brouter.com')">
              <span class="demo-dot dot-admin"></span>
              <span class="demo-email">admin@b2brouter.com</span>
              <span class="demo-role">Admin</span>
            </button>
            <button class="demo-btn" onclick="fillLogin('analyst@b2brouter.com')">
              <span class="demo-dot dot-internal"></span>
              <span class="demo-email">analyst@b2brouter.com</span>
              <span class="demo-role">Internal</span>
            </button>
            <button class="demo-btn" onclick="fillLogin('client@acmecorp.com')">
              <span class="demo-dot dot-client"></span>
              <span class="demo-email">client@acmecorp.com</span>
              <span class="demo-role">Client</span>
            </button>
          </div>
        </div>
      )}

      <div class="back-link">
        <a href="/">← Back to portal selection</a>
      </div>
    </div>
  </main>
</Layout>

<script>
  function fillLogin(email: string) {
    (document.getElementById('email') as HTMLInputElement).value = email;
    (document.getElementById('password') as HTMLInputElement).value = 'demo1234';
    document.getElementById('login-form')?.dispatchEvent(new Event('input'));
  }

  // Show loading state on submit
  document.getElementById('login-form')?.addEventListener('submit', () => {
    const btn = document.getElementById('btn-submit') as HTMLButtonElement;
    const label = btn.querySelector('.btn-submit-text');
    if (label) label.textContent = 'Signing in…';
    btn.disabled = true;
  });
</script>

