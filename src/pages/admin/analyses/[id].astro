---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSession, isAdminRole } from '../../../lib/session';
import { canUsePlanAdvisorApi } from '../../../lib/pa-api';
import { getFreshSupabaseAccessToken } from '../../../lib/supabase-session';
import { fetchAnalysesCount } from '../../../lib/admin-analyses-count';
import AnalysisDetail from '../../../components/admin/AnalysisDetail';
import '../../../styles/pages/admin-analysis-detail.css';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');
if (!isAdminRole(session.role)) return Astro.redirect('/dashboard');

const { id } = Astro.params;
const safeId = id ?? '';

let paToken: string | null = null;
if (session.supabaseAccessToken?.trim()) {
  const fresh = await getFreshSupabaseAccessToken(Astro.cookies);
  if (fresh.ok) paToken = fresh.accessToken;
}

const apiReady = canUsePlanAdvisorApi(session);

let adminNotice: string | null = null;
let analysesCount = 0;

if (!session.supabaseAccessToken) {
  adminNotice = 'Demo session (no JWT). Configure Supabase sign-in for live analysis detail.';
} else if (!paToken) {
  adminNotice = 'Session expired. Please sign out and sign in again.';
}

// Fetch real analyses count for sidebar
if (apiReady && paToken) {
  analysesCount = await fetchAnalysesCount(paToken);
}
---

<AdminLayout
  title="Analysis Detail"
  breadcrumbs={[
    { label: 'AI Analyses', href: '/admin/analyses' },
    { label: 'Detail' },
  ]}
  notice={adminNotice}
  analysesCount={analysesCount}
>
  <div class="page-admin-analyses-index panel">
    {!session.supabaseAccessToken ? (
      <div class="empty-state" style="padding: 2rem; text-align: center;">
        <h2>Cannot Load Analysis</h2>
        <p style="margin-top: 1rem; color: #6b7280;">
          {adminNotice || 'Please sign in to view analysis details.'}
        </p>
        <a 
          href="/admin/login"
          style="display: inline-block; margin-top: 1.5rem; padding: 0.5rem 1rem; background: #4f46e5; color: white; text-decoration: none; border-radius: 0.375rem;"
        >
          Sign In
        </a>
      </div>
    ) : (
      <AnalysisDetail 
        client:load
        analysisId={safeId}
      />
    )}
  </div>
</AdminLayout>
