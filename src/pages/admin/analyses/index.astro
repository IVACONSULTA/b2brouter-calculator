---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSession, isAdminRole } from '../../../lib/session';
import {
  canUsePlanAdvisorApi,
  paFetchJson,
} from '../../../lib/pa-api';
import { getFreshSupabaseAccessToken } from '../../../lib/supabase-session';
import { DUMMY_ANALYSES } from '../../../lib/dummy-data';
import '../../../styles/pages/admin-analyses-index.css';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');
if (!isAdminRole(session.role)) return Astro.redirect('/dashboard');

let paToken: string | null = null;
if (session.supabaseAccessToken?.trim()) {
  const fresh = await getFreshSupabaseAccessToken(Astro.cookies);
  if (fresh.ok) paToken = fresh.accessToken;
}

const apiReady = canUsePlanAdvisorApi(session);

type DocAnalysisListApi = {
  success?: boolean;
  mock?: boolean;
  items?: typeof DUMMY_ANALYSES;
};

let adminNotice: string | null = null;
let analyses = DUMMY_ANALYSES;

if (!session.supabaseAccessToken) {
  adminNotice =
    'Demo session (no JWT). Configure Supabase sign-in + API_BASE_URL for live analysis list.';
} else if (!(import.meta.env.API_BASE_URL ?? '').trim()) {
  adminNotice = 'Set API_BASE_URL to reach Plan Advisor from this app.';
} else if (!paToken) {
  adminNotice =
    'Session expired. Please sign out and sign in again so a fresh Supabase token is stored.';
}

if (apiReady && paToken && (import.meta.env.API_BASE_URL ?? '').trim().length > 0) {
  const res = await paFetchJson<DocAnalysisListApi>('/admin/document-analyses', paToken);
  if (res.ok && res.data.items?.length) {
    analyses = res.data.items as typeof DUMMY_ANALYSES;
    if (res.data.mock && !adminNotice) {
      adminNotice =
        'Document analysis data is mock/fixture until the Documents Agent is connected to the API.';
    }
  } else if (!res.ok) {
    const suffix = ` Plan Advisor unreachable (HTTP ${res.status}). Showing demo placeholders.`;
    adminNotice = (adminNotice ? adminNotice.trim() + suffix : suffix.trim());
  }
}

const pendingCount = analyses.filter((a) => a.status === 'pending_review').length;
---

<AdminLayout
  title="AI Analyses"
  breadcrumbs={[{ label: 'Admin' }, { label: 'AI Analyses' }]}
  notice={adminNotice}
  analysesPendingCount={pendingCount}
>
  <div class="page-admin-analyses-index panel">
    <table class="table">
      <thead>
        <tr>
          <th>Country / Provider</th>
          <th>Date</th>
          <th>Rules</th>
          <th>Plans</th>
          <th>Pending Review</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {analyses.map(a => (
          <tr>
            <td class="bold">{a.country} / {a.provider}</td>
            <td class="muted">{a.created_at}</td>
            <td>{a.rules_proposed} proposed · <span class="green">{a.rules_approved} approved</span></td>
            <td>{a.plans_proposed} proposed · <span class="green">{a.plans_approved} approved</span></td>
            <td>
              {a.pending_review > 0
                ? <span class="badge badge-amber">{a.pending_review} pending</span>
                : <span class="badge badge-green">All reviewed</span>
              }
            </td>
            <td>
              {a.status === 'pending_review'
                ? <span class="badge badge-amber">Needs review</span>
                : <span class="badge badge-green">Completed</span>
              }
            </td>
            <td>
              <a href={`/admin/analyses/${a.id}`} class="btn-action">
                {a.status === 'pending_review' ? 'Review →' : 'View →'}
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>

