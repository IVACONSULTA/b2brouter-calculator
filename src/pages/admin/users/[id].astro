---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSession, isAdminRole } from '../../../lib/session';
import {
  canUsePlanAdvisorApi,
  paFetchJson,
} from '../../../lib/pa-api';
import { getFreshSupabaseAccessToken } from '../../../lib/supabase-session';
import '../../../styles/pages/admin-settings.css';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');
if (!isAdminRole(session.role)) return Astro.redirect('/dashboard');

const { id } = Astro.params;
const userId = id ?? '';

let paToken: string | null = null;
if (session.supabaseAccessToken?.trim()) {
  const fresh = await getFreshSupabaseAccessToken(Astro.cookies);
  if (fresh.ok) paToken = fresh.accessToken;
}

const apiReady = canUsePlanAdvisorApi(session);

interface UserData {
  id: string;
  email: string;
  full_name: string | null;
  role: 'admin' | 'internal' | 'client';
  active: boolean;
  created_at: string;
  company_id: string | null;
  company_name: string | null;
  company_type: 'internal' | 'client';
  ai_calls_this_month?: number | null;
}

let adminNotice: string | null = null;
let user: UserData | null = null;

function formatUserCreatedAt(raw: string): string {
  const d = new Date(raw);
  if (Number.isNaN(d.getTime())) return raw;
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}

if (!session.supabaseAccessToken) {
  adminNotice = 'Demo session (no JWT). Configure Supabase sign-in + API_BASE_URL.';
} else if (!(import.meta.env.API_BASE_URL ?? '').trim()) {
  adminNotice = 'Set API_BASE_URL to reach Plan Advisor from this app.';
} else if (!paToken) {
  adminNotice = 'Session expired. Please sign out and sign in again.';
}

if (apiReady && paToken && userId) {
  const userRes = await paFetchJson<UserData>(`/admin/users/${encodeURIComponent(userId)}`, paToken);
  if (userRes.ok && userRes.data) {
    user = userRes.data;
  } else if (!userRes.ok) {
    adminNotice = `Could not load user (HTTP ${userRes.status}).`;
  }
}

const roleMeta: Record<string, { label: string; cls: string }> = {
  admin:    { label: 'Admin',    cls: 'r-admin' },
  internal: { label: 'Internal', cls: 'r-internal' },
  client:   { label: 'Client',   cls: 'r-client' },
};
---

<AdminLayout
  title={user ? `Edit User — ${user.full_name || user.email}` : 'User Not Found'}
  breadcrumbs={[
    { label: 'Admin', href: '/admin/dashboard' },
    { label: 'Settings & Users', href: '/admin/settings' },
    { label: user ? 'Edit User' : 'Not Found' },
  ]}
  notice={adminNotice}
>
  <div class="page-admin-settings">
    {!user ? (
      <div class="empty-state" style="padding: 2rem; text-align: center;">
        <h2>User Not Found</h2>
        <p style="margin-top: 1rem; color: #6b7280;">
          The user with ID <code>{userId}</code> could not be loaded.
        </p>
        <a 
          href="/admin/settings"
          style="display: inline-block; margin-top: 1.5rem; padding: 0.5rem 1rem; background: #4f46e5; color: white; text-decoration: none; border-radius: 0.375rem;"
        >
          ← Back to Settings
        </a>
      </div>
    ) : (
      <div class="panel" style="max-width: 600px; margin: 0 auto;">
        <div class="panel-head" style="margin-bottom: 1.5rem;">
          <h2 class="panel-title">Edit User</h2>
          <p class="panel-subtitle">{user.full_name || user.email} · <span class={`role-badge ${roleMeta[user.role].cls}`}>{roleMeta[user.role].label}</span></p>
        </div>

        <form id="edit-user-form" class="form-grid" data-user-id={user.id}>
          <div class="field field-readonly">
            <label>User ID <span class="readonly-badge">Read-only</span></label>
            <input type="text" value={user.id} disabled class="readonly-input" />
            <small class="hint">User ID is system-generated and cannot be changed</small>
          </div>

          <div class="field">
            <label>Email <span class="req">*</span></label>
            <input type="email" name="email" value={user.email} required />
          </div>

          <div class="field">
            <label>Full Name <span class="req">*</span></label>
            <input type="text" name="full_name" value={user.full_name || ''} required />
          </div>

          <div class="field">
            <label>Role <span class="req">*</span></label>
            <select name="role" required>
              <option value="admin" selected={user.role === 'admin'}>Admin</option>
              <option value="internal" selected={user.role === 'internal'}>Internal</option>
              <option value="client" selected={user.role === 'client'}>Client</option>
            </select>
          </div>

          <div class="field">
            <label>Company</label>
            <select name="company_id">
              <option value="" selected={!user.company_id}>Select company…</option>
              <option value="comp-internal" selected={user.company_id === 'comp-internal'}>B2Brouter Internal (internal)</option>
              <option value="comp-acme" selected={user.company_id === 'comp-acme'}>Acme Corp (client)</option>
              <option value="comp-global" selected={user.company_id === 'comp-global'}>Global Trade Ltd (client)</option>
              <option value="comp-tech" selected={user.company_id === 'comp-tech'}>Tech Solutions SL (client)</option>
            </select>
          </div>

          <div class="field">
            <label>Status</label>
            <div style="display: flex; gap: 1rem; margin-top: 0.5rem;">
              <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                <input type="radio" name="active" value="true" checked={user.active} />
                <span>Active</span>
              </label>
              <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                <input type="radio" name="active" value="false" checked={!user.active} />
                <span>Inactive</span>
              </label>
            </div>
          </div>

          <div class="field">
            <label>Created</label>
            <input type="text" value={formatUserCreatedAt(user.created_at)} disabled style="background: #f3f4f6; cursor: not-allowed;" />
          </div>

          <div class="field full">
            <div class="form-actions" style="display: flex; gap: 1rem; justify-content: flex-start;">
              <a href="/admin/settings" class="btn-cancel" style="padding: 0.5rem 1rem; background: #6b7280; color: white; text-decoration: none; border-radius: 0.375rem;">
                Cancel
              </a>
              <button type="submit" class="btn-primary" style="padding: 0.5rem 1rem; background: #4f46e5; color: white; border: none; border-radius: 0.375rem; cursor: pointer;">
                Save Changes
              </button>
            </div>
          </div>
        </form>

        <div id="save-result" style="margin-top: 1rem; padding: 0.75rem; border-radius: 0.375rem; display: none;"></div>
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .field-readonly {
    opacity: 0.8;
  }
  .readonly-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: #6b7280;
    background: #f3f4f6;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    margin-left: 0.5rem;
  }
  .readonly-input {
    background: #f3f4f6 !important;
    cursor: not-allowed !important;
    color: #6b7280 !important;
  }
  .hint {
    color: #6b7280;
    font-size: 0.75rem;
  }
</style>

<script>
  const form = document.getElementById('edit-user-form');
  const resultDiv = document.getElementById('save-result');
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  if (form && resultDiv) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const userId = form.dataset.userId;
      const formData = new FormData(form as HTMLFormElement);
      
      const data = {
        email: formData.get('email'),
        full_name: formData.get('full_name'),
        role: formData.get('role'),
        company_id: formData.get('company_id') || null,
        active: formData.get('active') === 'true',
      };

      // Disable submit button during request
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving…';
      }

      try {
        const response = await fetch(`/api/pa/admin/users/${userId}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'same-origin',
          body: JSON.stringify(data),
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok) {
          resultDiv.style.display = 'block';
          resultDiv.style.background = '#d1fae5';
          resultDiv.style.color = '#065f46';
          resultDiv.innerHTML = `
            <strong>✓ User updated successfully!</strong><br>
            <small>Synced to Supabase Auth and Railway database</small>
          `;
          
          // Re-enable button
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Save Changes';
          }
          
          // Redirect after short delay
          setTimeout(() => {
            window.location.href = '/admin/settings';
          }, 1500);
        } else {
          // Error response
          resultDiv.style.display = 'block';
          resultDiv.style.background = '#fee2e2';
          resultDiv.style.color = '#991b1b';
          resultDiv.innerHTML = `
            <strong>✗ Update failed</strong><br>
            <small>${result.message || result.error || `HTTP ${response.status}`}</small>
          `;
          
          // Re-enable button
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Save Changes';
          }
        }
      } catch (err) {
        resultDiv.style.display = 'block';
        resultDiv.style.background = '#fee2e2';
        resultDiv.style.color = '#991b1b';
        resultDiv.innerHTML = `
          <strong>✗ Network error</strong><br>
          <small>${err instanceof Error ? err.message : 'Please try again'}</small>
        `;
        
        // Re-enable button
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Save Changes';
        }
      }
    });
  }
</script>
