---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import DocumentUploadPanel from '../../../../components/admin/DocumentUploadPanel';
import WizardCountryDraftIsland from '../../../../components/admin/WizardCountryDraftIsland';
import { getSession, isAdminRole } from '../../../../lib/session';
import {
  canUsePlanAdvisorApi,
  paFetchJson,
} from '../../../../lib/pa-api';
import { getFreshSupabaseAccessToken } from '../../../../lib/supabase-session';
import { resolvePlanAdvisorProfileIds } from '../../../../lib/admin-resolve-profile-api';
import { resolveAdminWizardProfile } from '../../../../lib/admin-wizard-profile-fallback';
import {
  hasLocalDocumentFiles,
  readLocalDocumentsCombined,
  useLocalDocumentStorage,
} from '../../../../lib/admin-documents-local';
import { paUploadLog } from '../../../../lib/pa-upload-debug';
import { parsePaUiProfileUuidMap } from '../../../../lib/pa-ui-profile-uuid-map';
import { isDraftProfileRouteId } from '../../../../lib/country-wizard-draft';
import { DUMMY_DOCUMENTS, DOCUMENT_TYPES } from '../../../../lib/dummy-data';
import '../../../../styles/pages/admin-country-documents.css';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');
if (!isAdminRole(session.role)) return Astro.redirect('/dashboard');

const { id: routeProfileId } = Astro.params;
if (!routeProfileId) return Astro.redirect('/countries');

const profile = resolveAdminWizardProfile(routeProfileId);

// Check if this is a wizard draft with stored API UUIDs (server-side cannot read sessionStorage directly)
const isDraft = isDraftProfileRouteId(routeProfileId);

const localDocMode = useLocalDocumentStorage();
const devLocalFolder =
  import.meta.env.DEV && hasLocalDocumentFiles(routeProfileId);
const useLocalDocumentsListing = localDocMode || devLocalFolder;

let paToken: string | null = null;
if (session.supabaseAccessToken?.trim()) {
  const fresh = await getFreshSupabaseAccessToken(Astro.cookies);
  if (fresh.ok) paToken = fresh.accessToken;
}

const apiReady = canUsePlanAdvisorApi(session);

type DocRow = {
  id: string;
  filename: string;
  document_type: string;
  description?: string;
  copyright_status: string;
  uploaded_at: string;
  size: string;
  selected?: boolean;
};

const copyrightMeta: Record<string, { label: string; cls: string; desc: string }> = {
  pending: { label: 'Pending', cls: 'c-pending', desc: 'Not yet analyzed' },
  clear: { label: 'Clear', cls: 'c-clear', desc: 'No restrictions detected' },
  restricted: { label: 'Restricted', cls: 'c-restricted', desc: 'Verbatim extraction prohibited; factual rules only' },
  blocked: { label: 'Blocked', cls: 'c-blocked', desc: 'AI opt-out clause detected — must be reviewed manually' },
};

function formatApiDate(raw: string): string {
  const d = new Date(raw);
  if (Number.isNaN(d.getTime())) return raw;
  return d.toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
}

let adminNotice: string | null = null;
let documents: DocRow[] = DUMMY_DOCUMENTS.map((d) => ({
  id: d.id,
  filename: d.filename,
  document_type: d.document_type,
  description: d.description,
  copyright_status: d.copyright_status,
  uploaded_at: d.uploaded_at,
  size: d.size,
  selected: d.selected,
}));

let apiTarget: {
  profile_id: string;
  country_id: string;
  provider_id: string;
} | null = null;

const uiProfileUuidBySlug = parsePaUiProfileUuidMap();
const uuidOverrideForSlug = uiProfileUuidBySlug[routeProfileId] ?? null;

/**
 * Wizard drafts have API UUIDs stored in sessionStorage (created at step 1 via /admin/countries/new).
 * For draft routes, skip SSR resolution — resolving by country+provider+version would return the
 * already-active profile UUID, causing documents to be linked to the wrong profile.
 * The island hydrates with the correct UUID from sessionStorage and passes it to the upload panel.
 *
 * For non-draft (static/legacy) routes, SSR resolution is still used.
 */
if (!isDraft && apiReady && paToken && (import.meta.env.API_BASE_URL ?? '').trim()) {
  const resolved = await resolvePlanAdvisorProfileIds(
    paToken,
    {
      countryCode: profile.country.code,
      providerName: profile.provider.name,
      version: profile.version,
    },
    { uuidOverride: uuidOverrideForSlug },
  );
  if (resolved) {
    apiTarget = {
      profile_id: resolved.id,
      country_id: resolved.country_id,
      provider_id: resolved.provider_id,
    };
  }
}

if (useLocalDocumentsListing) {
  const local = readLocalDocumentsCombined(routeProfileId);
  documents = local.map((item) => ({
    id: item.id,
    filename: item.filename,
    document_type: item.document_type,
    description: item.description ?? undefined,
    copyright_status: item.copyright_status,
    uploaded_at: formatApiDate(item.created_at),
    size: item.size_label,
    selected: item.copyright_status !== 'blocked',
  }));
  if (localDocMode) {
    adminNotice =
      'Local document storage (PA_LOCAL_DOCUMENT_STORAGE): files in docs/uploads/ are not sent to Railway.';
  } else if (devLocalFolder) {
    adminNotice = apiTarget
      ? 'Development: listing files from docs/uploads/' +
        routeProfileId +
        '/. New uploads use Plan Advisor (Railway) when signed in.'
      : 'Development: listing files from docs/uploads/' +
        routeProfileId +
        '/. Resolve API profile UUIDs (same country/provider/version as Plan Advisor) to enable Railway upload, or set PA_LOCAL_DOCUMENT_STORAGE=1 for local-only uploads.';
  }
} else if (apiReady && paToken && (import.meta.env.API_BASE_URL ?? '').trim()) {
  if (apiTarget) {
    const list = await paFetchJson<
      Array<{
        id: string;
        filename: string;
        document_type: string;
        description?: string | null;
        copyright_status: string;
        created_at: string;
      }>
    >(`/admin/documents?profile_id=${encodeURIComponent(apiTarget.profile_id)}`, paToken);
    if (list.ok && Array.isArray(list.data)) {
      documents = list.data.map((r) => ({
        id: r.id,
        filename: r.filename,
        document_type: r.document_type,
        description: r.description ?? undefined,
        copyright_status: r.copyright_status,
        uploaded_at: formatApiDate(r.created_at),
        size: '—',
        selected: r.copyright_status !== 'blocked',
      }));
    } else if (!list.ok) {
      const suffix = ` Could not load documents (HTTP ${list.status}). Showing demo list.`;
      const noticeBefore: string | null = adminNotice;
      adminNotice = `${noticeBefore ?? ''}${suffix}`.trim();
    }
  } else {
    adminNotice =
      'Draft uploads are stored temporarily for AI analysis (steps 2–3). When you activate the calculation profile (step 4), include promote_profile_slug in the activate request (same value as this page’s profile id) so files are copied into live calculator storage.';
    const slist = await paFetchJson<
      Array<{
        id: string;
        filename: string;
        document_type: string;
        description?: string | null;
        copyright_status: string;
        created_at: string;
      }>
    >(`/admin/documents/staging?profile_slug=${encodeURIComponent(routeProfileId)}`, paToken);
    if (slist.ok && Array.isArray(slist.data)) {
      documents = slist.data.map((r) => ({
        id: r.id,
        filename: r.filename,
        document_type: r.document_type,
        description: r.description ?? undefined,
        copyright_status: r.copyright_status,
        uploaded_at: formatApiDate(r.created_at),
        size: '—',
        selected: r.copyright_status !== 'blocked',
      }));
    } else if (!slist.ok) {
      const suffix = ` Could not load staged documents (HTTP ${slist.status}). Showing demo list.`;
      adminNotice = `${adminNotice}${suffix}`.trim();
    }
  }
} else if (!session.supabaseAccessToken) {
  adminNotice = 'Demo session (no JWT). Sign in with Supabase + set API_BASE_URL for live uploads.';
} else if (!(import.meta.env.API_BASE_URL ?? '').trim()) {
  adminNotice = 'Set API_BASE_URL or PA_LOCAL_DOCUMENT_STORAGE=1 for document uploads.';
}

const clearDocs = documents.filter((d) => d.copyright_status === 'clear' || d.copyright_status === 'restricted');
const blockedDocs = documents.filter((d) => d.copyright_status === 'blocked');

const aiAnalysisHref = `/admin/countries/${routeProfileId}/ai-analysis`;

const hasApiBase = Boolean((import.meta.env.API_BASE_URL ?? '').trim());
const canUpload = Boolean(
  localDocMode || apiTarget || (apiReady && paToken && hasApiBase && !localDocMode),
);

const uploadMode: 'local' | 'live' | 'staging' = localDocMode ? 'local' : apiTarget ? 'live' : 'staging';

const uploadConfig = {
  profileSlug: routeProfileId,
  localMode: localDocMode,
  uploadMode,
  countryId: apiTarget?.country_id ?? '',
  providerId: apiTarget?.provider_id ?? '',
  profileId: apiTarget?.profile_id ?? '',
  canUpload,
};

paUploadLog('documents page SSR', {
  routeProfileId,
  apiReady,
  hasPaToken: Boolean(paToken),
  hasApiBaseUrl: Boolean((import.meta.env.API_BASE_URL ?? '').trim()),
  uuidMapOverride: Boolean(uuidOverrideForSlug),
  localDocMode,
  devLocalFolder,
  useLocalDocumentsListing,
  dummyProfileMatch: {
    countryCode: profile.country.code,
    providerName: profile.provider.name,
    version: profile.version,
  },
  apiTarget: apiTarget
    ? {
        profile_id: apiTarget.profile_id,
        country_id: apiTarget.country_id,
        provider_id: apiTarget.provider_id,
      }
    : null,
  canUpload,
  uploadMode,
});

const metaFor = (status: string) =>
  copyrightMeta[status] ?? copyrightMeta.pending;
---

<AdminLayout
  title={`Documents — ${profile.country.name} / ${profile.provider.name}`}
  notice={adminNotice}
  breadcrumbs={[
    { label: 'Countries', href: '/countries' },
    { label: `${profile.country.name} / ${profile.provider.name}`, href: `/admin/countries/${profile.id}/setup` },
    { label: 'Documents' },
  ]}
>
  <div class="page-admin-country-documents">
  <WizardCountryDraftIsland
    client:only="react"
    routeProfileId={routeProfileId}
    fallbackProfileJson={JSON.stringify(profile)}
    fallbackApiTarget={apiTarget ? JSON.stringify(apiTarget) : null}
    mode="documents"
  />
  <!-- Step bar -->
  <div class="step-bar">
    <a href={`/admin/countries/${profile.id}/setup`} class="step-tab">
      <span class="step-num done">✓</span> Profile Setup
    </a>
    <div class="step-connector"></div>
    <a href={`/admin/countries/${profile.id}/documents`} class="step-tab active">
      <span class="step-num">2</span> Documents
    </a>
    <div class="step-connector"></div>
    <a href={aiAnalysisHref} class="step-tab">
      <span class="step-num">3</span> AI Analysis
    </a>
    <div class="step-connector"></div>
    <span class="step-tab disabled">
      <span class="step-num">4</span> Activate
    </span>
  </div>



  <div class="two-col">
    <!-- Left: existing docs -->
    <div class="left-col">
      <div class="panel">
        <div class="panel-head">
          <div>
            <h2 class="panel-title">Uploaded Documents</h2>
            <p class="panel-subtitle">{documents.length} documents · {clearDocs.length} processable · {blockedDocs.length} blocked</p>
          </div>
        </div>

        {blockedDocs.length > 0 && (
          <div class="guardrail-banner">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"/>
              <line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <div>
              <p class="banner-title">AI opt-out detected in {blockedDocs.length} document(s)</p>
              <p class="banner-desc">These documents contain an explicit AI processing restriction (DSM Directive Art. 4 opt-out). They are excluded from AI analysis and must be reviewed manually.</p>
            </div>
          </div>
        )}

        <table class="table">
          <thead>
            <tr>
              <th style="width:32px">
                <input type="checkbox" id="select-all" />
              </th>
              <th>File</th>
              <th>Type</th>
              <th>Copyright</th>
              <th>Uploaded</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {documents.map((doc) => {
              const meta = metaFor(doc.copyright_status);
              return (
                <tr class={doc.copyright_status === 'blocked' ? 'row-blocked' : ''}>
                  <td>
                    <input
                      type="checkbox"
                      class="doc-checkbox"
                      data-doc-id={doc.id}
                      checked={doc.selected !== false && doc.copyright_status !== 'blocked'}
                      disabled={doc.copyright_status === 'blocked'}
                    />
                  </td>
                  <td>
                    <div class="file-cell">
                      <div class={`file-icon fi-${doc.copyright_status === 'restricted' ? 'restricted' : doc.copyright_status === 'blocked' ? 'blocked' : doc.copyright_status === 'clear' ? 'clear' : 'pending'}`}>
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                          <polyline points="14 2 14 8 20 8"/>
                        </svg>
                      </div>
                      <div>
                        <p class="file-name">{doc.filename}</p>
                        <p class="file-size">{doc.size}</p>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="type-label">
                      {DOCUMENT_TYPES.find((t) => t.value === doc.document_type)?.label ?? doc.document_type}
                    </span>
                  </td>
                  <td>
                    <div class="copyright-cell">
                      <span class={`c-badge ${meta.cls}`}>{meta.label}</span>
                      <span class="c-desc">{meta.desc}</span>
                    </div>
                  </td>
                  <td class="muted">{doc.uploaded_at}</td>
                  <td>
                    <div class="row-actions">
                      <button class="btn-icon" title="Download" type="button" onclick={`alert('Download is not implemented yet for ${doc.filename}')`}>
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                          <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                      </button>
                      <button 
                        class="btn-icon btn-danger btn-delete-doc" 
                        title="Delete" 
                        type="button"
                        data-doc-id={doc.id}
                        data-doc-filename={doc.filename}
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="3 6 5 6 21 6"/>
                          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                          <path d="M10 11v6"/><path d="M14 11v6"/>
                          <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>

       
        <div class="documents-footer-actions">
          <a href={`/admin/countries/${profile.id}/setup`} class="btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Back to Profile setup
          </a>

          <button
            type="button"
            id="btn-go-analysis"
            class="btn-go-analysis"
            data-href={aiAnalysisHref}
            data-profile-slug={routeProfileId}
            data-profile-id={uploadConfig.profileId}
            data-country-id={uploadConfig.countryId}
            data-provider-id={uploadConfig.providerId}
          >
            Go to Analysis
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Right: upload form -->
    <div class="right-col">
      <div class="panel">
        <h2 class="panel-title">Upload Document</h2>
        <p class="panel-subtitle" style="margin-bottom:1rem">PDF, DOCX, XLSX, CSV, TXT, MD — max 50 MB</p>

        <DocumentUploadPanel
          client:load
          uploadEndpoint="/api/pa/admin/documents/upload"
          copyrightCheckEndpoint="/api/pa/admin/documents/copyright-check"
          canUpload={canUpload}
          localMode={localDocMode}
          uploadMode={uploadConfig.uploadMode}
          profileSlug={routeProfileId}
          countryId={uploadConfig.countryId}
          providerId={uploadConfig.providerId}
          profileId={uploadConfig.profileId}
          documentTypes={DOCUMENT_TYPES}
        />
      </div>

      <!-- Copyright legend -->
      <div class="panel legend-panel">
        <h3 class="legend-title">Copyright status legend</h3>
        {Object.entries(copyrightMeta).map(([, meta]) => (
          <div class="legend-row">
            <span class={`c-badge ${meta.cls}`}>{meta.label}</span>
            <span class="legend-desc">{meta.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
  </div>
</AdminLayout>

<script is:inline>
  const selectAll = document.getElementById('select-all');
  const checkboxes = document.querySelectorAll('.doc-checkbox:not(:disabled)');

  if (selectAll instanceof HTMLInputElement) {
    selectAll.addEventListener('change', () => {
      const on = selectAll.checked;
      checkboxes.forEach((cb) => {
        if (cb instanceof HTMLInputElement) cb.checked = on;
      });
    });
  }
</script>

<script>
  import { initDocumentsGoAnalysis } from '../../../../scripts/documents-go-analysis';
  initDocumentsGoAnalysis();
</script>

<script>
  // Delete document functionality
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const deleteBtn = target.closest('.btn-delete-doc') as HTMLButtonElement | null;
    
    if (!deleteBtn) return;

    const docId = deleteBtn.dataset.docId;
    const filename = deleteBtn.dataset.docFilename || 'this document';

    if (!docId) {
      alert('Document ID is missing.');
      return;
    }

    const confirmed = confirm(
      `Are you sure you want to delete "${filename}"?\n\nThis action cannot be undone.`
    );

    if (!confirmed) return;

    deleteBtn.disabled = true;
    deleteBtn.style.opacity = '0.5';
    deleteBtn.style.cursor = 'wait';

    try {
      const response = await fetch(`/api/pa/admin/documents/delete?id=${encodeURIComponent(docId)}`, {
        method: 'DELETE',
        credentials: 'same-origin',
      });

      const raw = await response.text();
      let payload: unknown = null;
      if (raw.length) {
        try {
          payload = JSON.parse(raw);
        } catch {
          payload = null;
        }
      }

      if (!response.ok) {
        const errorMsg = typeof payload === 'object' && payload !== null && 'error' in payload
          ? String((payload as any).error)
          : `HTTP ${response.status}`;
        alert(`Delete failed: ${errorMsg}`);
        deleteBtn.disabled = false;
        deleteBtn.style.opacity = '';
        deleteBtn.style.cursor = '';
        return;
      }

      // Remove the row from the table with animation
      const row = deleteBtn.closest('tr');
      if (row) {
        row.style.transition = 'opacity 0.3s';
        row.style.opacity = '0';
        setTimeout(() => {
          row.remove();
          
          // Update document count in subtitle
          const subtitle = document.querySelector('.panel-subtitle');
          if (subtitle) {
            const currentText = subtitle.textContent || '';
            const match = currentText.match(/(\d+) documents/);
            if (match) {
              const currentCount = parseInt(match[1], 10);
              const newCount = Math.max(0, currentCount - 1);
              subtitle.textContent = currentText.replace(/\d+ documents/, `${newCount} documents`);
            }
          }
        }, 300);
      }

    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : String(err);
      alert(`Request failed: ${message}`);
      deleteBtn.disabled = false;
      deleteBtn.style.opacity = '';
      deleteBtn.style.cursor = '';
    }
  });
</script>
