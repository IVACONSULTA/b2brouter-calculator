---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSession, isAdminRole } from '../../../lib/session';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');
if (!isAdminRole(session.role)) return Astro.redirect('/dashboard');

const countries = [
  { code: 'FR', name: 'France' },
  { code: 'ES', name: 'Spain' },
  { code: 'DE', name: 'Germany' },
  { code: 'IT', name: 'Italy' },
  { code: 'PT', name: 'Portugal' },
  { code: 'NL', name: 'Netherlands' },
  { code: 'BE', name: 'Belgium' },
  { code: 'PL', name: 'Poland' },
  { code: 'RO', name: 'Romania' },
  { code: 'GR', name: 'Greece' },
];

const providers = [
  { name: 'B2Brouter', type: 'PA' },
  { name: 'SAP DRC', type: 'PA' },
  { name: 'Aruba PEC', type: 'PDP' },
  { name: 'InfoCert', type: 'PDP' },
  { name: 'Chorus Pro', type: 'PA' },
  { name: 'Peppol', type: 'PA' },
];

const currencies = ['EUR', 'GBP', 'PLN', 'RON'];
---

<AdminLayout
  title="New Country / Provider"
  breadcrumbs={[
    { label: 'Countries', href: '/countries' },
    { label: 'New Country / Provider' },
  ]}
>
  <div class="form-layout">
    <!-- Main form -->
    <div class="form-card">
      <div class="card-header">
        <h2>Country & Provider Details</h2>
        <p>Create a new calculation profile. You'll be able to upload documents and configure rules in the next steps.</p>
      </div>

      <!-- TODO: POST /api/admin/countries → App 2 POST /admin/countries -->
      <form id="new-country-form" class="form" action="#" method="POST">
        <div class="form-grid">
          <div class="field">
            <label for="country_code">Country <span class="required">*</span></label>
            <select id="country_code" name="country_code" required>
              <option value="" disabled selected>Select country…</option>
              {countries.map(c => (
                <option value={c.code}>{c.name} ({c.code})</option>
              ))}
            </select>
          </div>

          <div class="field">
            <label for="provider">Provider / PA <span class="required">*</span></label>
            <select id="provider" name="provider" required>
              <option value="" disabled selected>Select provider…</option>
              {providers.map(p => (
                <option value={p.name}>{p.name} — {p.type}</option>
              ))}
              <option value="__custom__">+ Custom provider…</option>
            </select>
          </div>

          <div class="field" id="custom-provider-wrap" style="display:none">
            <label for="provider_custom">Custom Provider Name <span class="required">*</span></label>
            <input type="text" id="provider_custom" name="provider_custom" placeholder="e.g. MyPA Platform" />
          </div>

          <div class="field" id="custom-type-wrap" style="display:none">
            <label for="provider_type">Provider Type</label>
            <select id="provider_type" name="provider_type">
              <option value="PA">PA (Plataforma de Acceso)</option>
              <option value="PDP">PDP (Plateforme de Dématérialisation Partenaire)</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="field">
            <label for="currency">Currency <span class="required">*</span></label>
            <select id="currency" name="currency" required>
              {currencies.map(c => (
                <option value={c} selected={c === 'EUR'}>{c}</option>
              ))}
            </select>
          </div>

          <div class="field">
            <label for="version">Initial Version</label>
            <input type="text" id="version" name="version" value="v1.0" placeholder="v1.0" />
            <span class="field-hint">Profile version identifier, e.g. v1.0, v2.1</span>
          </div>

          <div class="field full-width">
            <label for="calculation_basis">Calculation Basis</label>
            <input type="text" id="calculation_basis" name="calculation_basis" value="PA transactions" placeholder="PA transactions" />
            <span class="field-hint">Unit used for the deterministic calculation (defined by the provider)</span>
          </div>

          <div class="field full-width">
            <label for="notes">Notes</label>
            <textarea id="notes" name="notes" rows="3" placeholder="Any relevant context about this country / provider configuration…"></textarea>
          </div>
        </div>

        <div class="form-actions">
          <a href="/countries" class="btn-cancel">Cancel</a>
          <button type="submit" class="btn-primary" id="submit-btn">
            Create profile & continue to setup
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </form>
    </div>

    <!-- Side info -->
    <aside class="side-info">
      <div class="info-card">
        <h3>Setup workflow</h3>
        <ol class="steps">
          <li class="step active">
            <div class="step-num">1</div>
            <div>
              <p class="step-title">Create profile</p>
              <p class="step-desc">Country + Provider + Currency</p>
            </div>
          </li>
          <li class="step">
            <div class="step-num">2</div>
            <div>
              <p class="step-title">Upload documents</p>
              <p class="step-desc">Pricing sheets, legal decrees, contracts</p>
            </div>
          </li>
          <li class="step">
            <div class="step-num">3</div>
            <div>
              <p class="step-title">AI analysis</p>
              <p class="step-desc">Extract rules & plans from documents</p>
            </div>
          </li>
          <li class="step">
            <div class="step-num">4</div>
            <div>
              <p class="step-title">Review & approve</p>
              <p class="step-desc">Approve rules and plans individually</p>
            </div>
          </li>
          <li class="step">
            <div class="step-num">5</div>
            <div>
              <p class="step-title">Activate profile</p>
              <p class="step-desc">Make it available to customers</p>
            </div>
          </li>
        </ol>
      </div>

      <div class="info-card warn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <div>
          <p class="warn-title">Only one active version per profile</p>
          <p class="warn-desc">When activating this version, any previously active version for the same country/provider will be archived automatically.</p>
        </div>
      </div>
    </aside>
  </div>
</AdminLayout>

<script>
  // Show/hide custom provider fields
  const providerSelect = document.getElementById('provider') as HTMLSelectElement;
  const customWrap = document.getElementById('custom-provider-wrap')!;
  const customTypeWrap = document.getElementById('custom-type-wrap')!;

  providerSelect.addEventListener('change', () => {
    const isCustom = providerSelect.value === '__custom__';
    customWrap.style.display = isCustom ? '' : 'none';
    customTypeWrap.style.display = isCustom ? '' : 'none';
  });

  // Form submit — wired up later to POST /admin/countries via App 2 API
  document.getElementById('new-country-form')!.addEventListener('submit', (e) => {
    e.preventDefault();
    // TODO: POST to API_BASE_URL/admin/countries
    // On success: redirect to /admin/countries/{newId}/setup
    const demoId = 'profile-new-demo';
    window.location.href = `/admin/countries/${demoId}/setup`;
  });
</script>

<style>
  .form-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 1.25rem;
    align-items: start;
  }

  @media (max-width: 900px) { .form-layout { grid-template-columns: 1fr; } }

  .form-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .card-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .card-header h2 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.3rem;
  }

  .card-header p {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .form {
    padding: 1.5rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 680px) { .form-grid { grid-template-columns: 1fr; } }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .full-width { grid-column: 1 / -1; }

  label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.01em;
  }

  .required { color: #ef4444; }

  input, select, textarea {
    padding: 0.6rem 0.85rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    font-size: 0.85rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.13s;
    width: 100%;
  }

  input:focus, select:focus, textarea:focus {
    border-color: var(--color-admin);
    box-shadow: 0 0 0 3px rgba(99,102,241,.1);
  }

  select { cursor: pointer; }
  textarea { resize: vertical; }

  .field-hint {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .form-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .btn-cancel {
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    transition: all 0.13s;
  }

  .btn-cancel:hover { color: var(--color-text); }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    background: var(--color-admin);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.13s;
  }

  .btn-primary:hover {
    background: var(--color-admin-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(99,102,241,.35);
  }

  /* Side info */
  .side-info {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .info-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.1rem;
  }

  .info-card h3 {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.9rem;
  }

  .steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    opacity: 0.45;
  }

  .step.active { opacity: 1; }

  .step-num {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .step.active .step-num {
    background: var(--color-admin);
    border-color: var(--color-admin);
    color: #fff;
  }

  .step-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.2;
  }

  .step-desc {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    margin-top: 0.15rem;
  }

  .info-card.warn {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    border-color: rgba(245,158,11,.25);
    background: rgba(245,158,11,.04);
    color: #f59e0b;
  }

  .info-card.warn svg { flex-shrink: 0; margin-top: 0.1rem; }

  .warn-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: #f59e0b;
    margin-bottom: 0.25rem;
  }

  .warn-desc {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>
