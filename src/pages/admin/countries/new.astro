---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSession, isAdminRole } from '../../../lib/session';
import '../../../styles/pages/admin-countries-new.css';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');
if (!isAdminRole(session.role)) return Astro.redirect('/dashboard');

const countries = [
  { code: 'FR', name: 'France' },
  { code: 'ES', name: 'Spain' },
  { code: 'DE', name: 'Germany' },
  { code: 'IT', name: 'Italy' },
  { code: 'PT', name: 'Portugal' },
  { code: 'NL', name: 'Netherlands' },
  { code: 'BE', name: 'Belgium' },
  { code: 'PL', name: 'Poland' },
  { code: 'RO', name: 'Romania' },
  { code: 'GR', name: 'Greece' },
];

const providers = [
  { name: 'B2Brouter', type: 'PA' },
  { name: 'SAP DRC', type: 'PA' },
  { name: 'Aruba PEC', type: 'PDP' },
  { name: 'InfoCert', type: 'PDP' },
  { name: 'Chorus Pro', type: 'PA' },
  { name: 'Peppol', type: 'PA' },
];

const currencies = ['EUR', 'GBP', 'PLN', 'RON'];
---

<AdminLayout
  title="New Country / Provider"
  breadcrumbs={[
    { label: 'Countries', href: '/countries' },
    { label: 'New Country / Provider' },
  ]}
>
  <div class="page-admin-countries-new">
  <div class="form-layout">
    <!-- Main form -->
    <div class="form-card">
      <div class="card-header">
        <h2>Country & Provider Details</h2>
        <p>Create a new calculation profile. You'll be able to upload documents and configure rules in the next steps.</p>
      </div>

      <!-- TODO: POST /api/admin/countries → App 2 POST /admin/countries -->
      <form id="new-country-form" class="form" action="#" method="POST">
        <div class="form-grid">
          <div class="field">
            <label for="country_code">Country <span class="required">*</span></label>
            <select id="country_code" name="country_code" required>
              <option value="" disabled selected>Select country…</option>
              {countries.map(c => (
                <option value={c.code}>{c.name} ({c.code})</option>
              ))}
            </select>
          </div>

          <div class="field">
            <label for="provider">Provider / PA <span class="required">*</span></label>
            <select id="provider" name="provider" required>
              <option value="" disabled selected>Select provider…</option>
              {providers.map(p => (
                <option value={p.name}>{p.name} — {p.type}</option>
              ))}
              <option value="__custom__">+ Custom provider…</option>
            </select>
          </div>

          <div class="field" id="custom-provider-wrap" style="display:none">
            <label for="provider_custom">Custom Provider Name <span class="required">*</span></label>
            <input type="text" id="provider_custom" name="provider_custom" placeholder="e.g. MyPA Platform" />
          </div>

          <div class="field" id="custom-type-wrap" style="display:none">
            <label for="provider_type">Provider Type</label>
            <select id="provider_type" name="provider_type">
              <option value="PA">PA (Plataforma de Acceso)</option>
              <option value="PDP">PDP (Plateforme de Dématérialisation Partenaire)</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="field">
            <label for="currency">Currency <span class="required">*</span></label>
            <select id="currency" name="currency" required>
              {currencies.map(c => (
                <option value={c} selected={c === 'EUR'}>{c}</option>
              ))}
            </select>
          </div>

          <div class="field">
            <label for="version">Initial Version</label>
            <input type="text" id="version" name="version" value="v1.0" placeholder="v1.0" />
            <span class="field-hint">Profile version identifier, e.g. v1.0, v2.1</span>
          </div>

          <div class="field full-width">
            <label for="calculation_basis">Calculation Basis</label>
            <input type="text" id="calculation_basis" name="calculation_basis" value="PA transactions" placeholder="PA transactions" />
            <span class="field-hint">Unit used for the deterministic calculation (defined by the provider)</span>
          </div>

          <div class="field full-width">
            <label for="notes">Notes</label>
            <textarea id="notes" name="notes" rows="3" placeholder="Any relevant context about this country / provider configuration…"></textarea>
          </div>
        </div>

        <div class="form-actions">
          <a href="/countries" class="btn-cancel">Cancel</a>
          <button type="submit" class="btn-primary" id="submit-btn">
            Create profile & continue to setup
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </form>
    </div>

    <!-- Side info -->
    <aside class="side-info">
      <div class="info-card">
        <h3>Setup workflow</h3>
        <ol class="steps">
          <li class="step active">
            <div class="step-num">1</div>
            <div>
              <p class="step-title">Create profile</p>
              <p class="step-desc">Country + Provider + Currency</p>
            </div>
          </li>
          <li class="step">
            <div class="step-num">2</div>
            <div>
              <p class="step-title">Upload documents</p>
              <p class="step-desc">Pricing sheets, legal decrees, contracts</p>
            </div>
          </li>
          <li class="step">
            <div class="step-num">3</div>
            <div>
              <p class="step-title">AI analysis</p>
              <p class="step-desc">Extract rules & plans from documents</p>
            </div>
          </li>
          <li class="step">
            <div class="step-num">4</div>
            <div>
              <p class="step-title">Review & approve</p>
              <p class="step-desc">Approve rules and plans individually</p>
            </div>
          </li>
          <li class="step">
            <div class="step-num">5</div>
            <div>
              <p class="step-title">Activate profile</p>
              <p class="step-desc">Make it available to customers</p>
            </div>
          </li>
        </ol>
      </div>

      <div class="info-card warn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <div>
          <p class="warn-title">Only one active version per profile</p>
          <p class="warn-desc">When activating this version, any previously active version for the same country/provider will be archived automatically.</p>
        </div>
      </div>
    </aside>
  </div>
  </div>
</AdminLayout>

<script>
  import {
    makeDraftProfileRouteId,
    saveCountryWizardDraft,
    type CountryWizardDraft,
  } from '../../../lib/country-wizard-draft';

  const providerSelect = document.getElementById('provider') as HTMLSelectElement;
  const customWrap = document.getElementById('custom-provider-wrap')!;
  const customTypeWrap = document.getElementById('custom-type-wrap')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  providerSelect.addEventListener('change', () => {
    const isCustom = providerSelect.value === '__custom__';
    customWrap.style.display = isCustom ? '' : 'none';
    customTypeWrap.style.display = isCustom ? '' : 'none';
  });

  function inferProviderType(optionText: string): 'PA' | 'PDP' | 'other' {
    const m = optionText.match(/—\s*(PA|PDP)\s*$/);
    if (m?.[1] === 'PA' || m?.[1] === 'PDP') return m[1];
    return 'PA';
  }

  document.getElementById('new-country-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();

    const countrySelect = document.getElementById('country_code') as HTMLSelectElement;
    const currencySelect = document.getElementById('currency') as HTMLSelectElement;
    const versionInput = document.getElementById('version') as HTMLInputElement;
    const calcInput = document.getElementById('calculation_basis') as HTMLInputElement;
    const notesInput = document.getElementById('notes') as HTMLTextAreaElement;
    const providerTypeSelect = document.getElementById('provider_type') as HTMLSelectElement;
    const providerCustomInput = document.getElementById('provider_custom') as HTMLInputElement;

    const countryCode = countrySelect.value.trim();
    const countryLabel = countrySelect.options[countrySelect.selectedIndex]?.text ?? countryCode;

    let providerName: string;
    let providerType: 'PA' | 'PDP' | 'other';

    if (providerSelect.value === '__custom__') {
      providerName = providerCustomInput.value.trim() || 'Custom provider';
      const t = providerTypeSelect.value;
      providerType = t === 'PDP' ? 'PDP' : t === 'other' ? 'other' : 'PA';
    } else {
      const opt = providerSelect.options[providerSelect.selectedIndex]?.text ?? '';
      providerName = providerSelect.value.trim();
      providerType = inferProviderType(opt);
    }

    const currency = currencySelect.value;
    const version = versionInput.value.trim() || 'v1.0';
    const calculationBasis = calcInput.value.trim() || 'PA transactions';
    const notes = notesInput.value.trim();

    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating profile…';

    // Create profile on Railway (auto-creates country/provider if needed)
    let apiProfileId: string | undefined;
    let apiCountryId: string | undefined;
    let apiProviderId: string | undefined;

    try {
      console.log('[New Country] Creating profile with auto-create for country/provider...');
      const res = await fetch('/api/pa/admin/profiles/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          country_code: countryCode,
          country_name: countryLabel.split('(')[0]?.trim() || countryLabel,
          provider_name: providerName,
          provider_type: providerType,
          version,
          currency,
          calculation_basis: calculationBasis,
          notes,
        }),
      });
      if (res.ok) {
        const data = (await res.json()) as { id: string; country_id: string; provider_id: string };
        apiProfileId = data.id;
        apiCountryId = data.country_id;
        apiProviderId = data.provider_id;
        console.log('[New Country] Profile created on Railway:', {
          profile_id: apiProfileId,
          country_id: apiCountryId,
          provider_id: apiProviderId,
        });
      } else {
        const errorText = await res.text();
        console.warn('[New Country] Profile creation failed:', res.status, errorText);
      }
    } catch (err) {
      console.error('[New Country] Profile creation error:', err);
      // Continue with local draft only
    }

    const profileRouteId = makeDraftProfileRouteId();

    const draft: CountryWizardDraft = {
      profileRouteId,
      countryCode,
      countryName: countryLabel.split('(')[0]?.trim() || countryLabel,
      providerName,
      providerType,
      currency,
      version,
      calculationBasis,
      notes,
      savedAt: new Date().toISOString(),
      apiProfileId,
      apiCountryId,
      apiProviderId,
    };

    console.log('[New Country] Saving draft to sessionStorage:', {
      profileRouteId: draft.profileRouteId,
      hasApiUUIDs: Boolean(apiProfileId && apiCountryId && apiProviderId),
    });

    saveCountryWizardDraft(draft);

    window.location.href = `/admin/countries/${encodeURIComponent(profileRouteId)}/setup`;
  });
</script>

