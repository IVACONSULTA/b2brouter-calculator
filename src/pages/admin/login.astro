---
import Layout from '../../layouts/Layout.astro';
import { getSession, isAdminRole } from '../../lib/session';
import { isDemoAuthMode } from '../../lib/supabase';
import '../../styles/pages/admin-login.css';

const session = getSession(Astro.cookies);
if (session) {
  if (isAdminRole(session.role)) return Astro.redirect('/admin/dashboard');
  return Astro.redirect('/dashboard');
}

const errorMessages: Record<string, string> = {
  invalid_credentials:
    'Incorrect email or password, or no user in this Supabase project. Reset the password under Supabase Dashboard → Authentication.',
  email_not_confirmed:
    'Confirm your email first, or adjust Supabase Auth email confirmation settings.',
  missing_fields: 'Please enter your email and password.',
  wrong_portal:
    'This portal is for administrator accounts only. Use the Customer Portal with your internal or client account.',
  server_config:
    'Server misconfiguration: SUPABASE_ANON_KEY is missing while SUPABASE_URL is set. In Netlify → Site configuration → Environment variables, add SUPABASE_ANON_KEY (same value as in Supabase → Project Settings → API → anon public). Ensure variables apply to Branch deploys / All deploy contexts.',
  server_error: 'Something went wrong while signing in. Please try again or contact support.',
};

const errorKey = Astro.url.searchParams.get('error') ?? '';
const errorMsg = errorMessages[errorKey] ?? '';

const isDemoMode = isDemoAuthMode();
---

<Layout title="Admin sign in">
  <main class="page-admin-login login-page">
    <div class="login-card">
      <div class="login-header">
        <div class="icon admin">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <div>
          <h1>Admin Portal</h1>
          <p>Sign admins and operators with full system access</p>
        </div>
      </div>

      <div class="divider"></div>

      {isDemoMode && (
        <div class="demo-banner">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          <div><strong>Demo mode</strong> — use demo accounts below; role must be <code>admin</code> in <code>public.profiles</code> in Supabase.</div>
        </div>
      )}

      {errorMsg && (
        <div class="error-banner">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          {errorMsg}
        </div>
      )}

      <form action="/api/auth/login?from=admin" method="POST" class="login-form" id="login-form">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="admin@company.com" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="••••••••" autocomplete="current-password" required />
        </div>
        <button type="submit" class="btn-submit" id="btn-submit">
          <span class="btn-submit-text">Sign in</span>
        </button>
      </form>

      {isDemoMode && (
        <div class="demo-accounts">
          <p class="demo-accounts-title">Demo (admin only on this page)</p>
          <div class="demo-list">
            <button type="button" class="demo-btn" data-email="admin@b2brouter.com">
              <span class="demo-dot dot-admin"></span><span class="demo-email">admin@b2brouter.com</span><span class="demo-role">Admin</span>
            </button>
          </div>
        </div>
      )}

      <div class="back-link"><a href="/">← Back to portal selection</a></div>
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll('.demo-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const email = (btn as HTMLElement).dataset.email!;
      (document.getElementById('email') as HTMLInputElement).value = email;
      (document.getElementById('password') as HTMLInputElement).value = 'demo1234';
    });
  });
  document.getElementById('login-form')?.addEventListener('submit', () => {
    const b = document.getElementById('btn-submit') as HTMLButtonElement;
    const label = b.querySelector('.btn-submit-text');
    if (label) label.textContent = 'Signing in…';
    b.disabled = true;
  });
</script>

