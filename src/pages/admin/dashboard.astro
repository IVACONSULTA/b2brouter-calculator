---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession, isAdminRole } from '../../lib/session';
import {
  canUsePlanAdvisorApi,
  paFetchJson,
} from '../../lib/pa-api';
import { getFreshSupabaseAccessToken } from '../../lib/supabase-session';
import { DUMMY_PROFILES, DUMMY_ANALYSES, DUMMY_SCENARIOS, DUMMY_DOCUMENTS } from '../../lib/dummy-data';
import '../../styles/pages/admin-dashboard.css';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');
if (!isAdminRole(session.role)) return Astro.redirect('/dashboard');

let paToken: string | null = null;
if (session.supabaseAccessToken?.trim()) {
  const fresh = await getFreshSupabaseAccessToken(Astro.cookies);
  if (fresh.ok) paToken = fresh.accessToken;
}

const apiReady = canUsePlanAdvisorApi(session);

type AdminDashApi = {
  success?: boolean;
  kpis?: {
    active_profiles: number;
    profiles_in_progress: number;
    analyses_pending_review: number;
  };
  profiles?: Array<{
    id: string;
    country: { code: string; name: string };
    provider: { name: string; type: string };
    version: string;
    status: string;
    analysis_id?: string | null;
  }>;
  recent_documents?: Array<{
    id: string;
    filename: string;
    copyright_status: string;
    uploaded_at: string;
  }>;
  recent_scenarios?: Array<{
    id: string;
    client_name?: string | null;
    created_at: string;
    has_summary?: boolean;
    recommended_plan?: string | null;
    total_annual_cost?: number | string | null;
    country_name?: string | null;
    provider_name?: string | null;
  }>;
  document_analyses?: {
    success?: boolean;
    mock?: boolean;
    items?: typeof DUMMY_ANALYSES;
  };
};

function formatDocUploadedAt(raw: string): string {
  const t = raw?.trim();
  if (!t) return '—';
  const d = new Date(t);
  if (Number.isNaN(d.getTime())) return t;
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}

function formatScenarioDate(raw: string): string {
  const t = raw?.trim();
  if (!t) return '—';
  const d = new Date(t);
  if (Number.isNaN(d.getTime())) return t;
  return d.toLocaleString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
}

type AdminProfileTableRow = {
  id: string;
  country: { code: string; name: string };
  provider: { name: string; type: string };
  version: string;
  currency: string;
  status: 'active' | 'draft' | 'pending_approval' | 'archived';
  active_from: string | null;
  created_at: string;
  rules_count: number;
  plans_count: number;
  analysis_id: string | null;
};

let adminNotice: string | null = null;

let tableProfiles: AdminProfileTableRow[] = DUMMY_PROFILES.map((p) => ({ ...p })) as AdminProfileTableRow[];
let pendingAnalyses = DUMMY_ANALYSES.filter((a) => a.status === 'pending_review');
let mockAnalysesList = DUMMY_ANALYSES;
let recentDocs: Array<{ filename: string; copyright_status: string; uploaded_at: string }> =
  DUMMY_DOCUMENTS.slice(0, 3).map((d) => ({
    filename: d.filename,
    copyright_status: d.copyright_status,
    uploaded_at: d.uploaded_at,
  }));

let recentScenarios: Array<{
  id: string;
  client_name: string;
  country: string;
  provider: string;
  recommended_plan: string;
  total_cost: number;
  has_summary: boolean;
  created_at: string;
}> = DUMMY_SCENARIOS.slice(0, 4).map((s) => ({
  client_name: s.client_name,
  country: s.country,
  provider: s.provider,
  recommended_plan: s.recommended_plan,
  total_cost: s.total_cost,
  has_summary: s.has_summary,
  created_at: s.created_at,
  id: s.id,
}));

let kpiActive = tableProfiles.filter((p) => p.status === 'active').length;
let kpiInProgress = tableProfiles.filter((p) => p.status === 'draft' || p.status === 'pending_approval').length;
let kpiAnalysesPending = pendingAnalyses.length;
let kpiRecentScenarioCount = recentScenarios.length;

let reviewQuickHref = '/admin/analyses';
if (pendingAnalyses.length && pendingAnalyses[0]?.id) {
  reviewQuickHref = `/admin/analyses/${pendingAnalyses[0].id}`;
}

if (!session.supabaseAccessToken) {
  adminNotice =
    'Demo session (no JWT). Configure Supabase sign-in + API_BASE_URL for live admin dashboard data.';
} else if (!(import.meta.env.API_BASE_URL ?? '').trim()) {
  adminNotice = 'Set API_BASE_URL to reach Plan Advisor from this app.';
} else if (!paToken) {
  adminNotice =
    'Session expired. Please sign out and sign in again so a fresh Supabase token is stored.';
}

if (apiReady && paToken && (import.meta.env.API_BASE_URL ?? '').trim().length > 0) {
  const dash = await paFetchJson<AdminDashApi>('/admin/dashboard', paToken);
  if (dash.ok && dash.data.success !== false) {
    if (Array.isArray(dash.data.profiles)) {
      tableProfiles = dash.data.profiles.map((p) => ({
        id: p.id,
        country: p.country,
        provider: p.provider,
        version: p.version,
        currency: '',
        status: p.status as AdminProfileTableRow['status'],
        active_from: null,
        created_at: '',
        rules_count: 0,
        plans_count: 0,
        analysis_id: p.analysis_id ?? null,
      }));
    }
    if (dash.data.kpis) {
      kpiActive = dash.data.kpis.active_profiles;
      kpiInProgress = dash.data.kpis.profiles_in_progress;
      kpiAnalysesPending = dash.data.kpis.analyses_pending_review;
    }
    if (dash.data.document_analyses?.items?.length) {
      mockAnalysesList = dash.data.document_analyses.items as typeof DUMMY_ANALYSES;
      pendingAnalyses = mockAnalysesList.filter((a) => a.status === 'pending_review');
      if (pendingAnalyses.length && pendingAnalyses[0]?.id) {
        reviewQuickHref = `/admin/analyses/${pendingAnalyses[0].id}`;
      }
    }
    if (dash.data.recent_documents?.length) {
      recentDocs = dash.data.recent_documents.slice(0, 3).map((d) => ({
        filename: d.filename,
        copyright_status: d.copyright_status,
        uploaded_at: typeof d.uploaded_at === 'string' ? d.uploaded_at : String(d.uploaded_at),
      }));
    }
    if (dash.data.recent_scenarios?.length) {
      recentScenarios = dash.data.recent_scenarios.map((s) => ({
        id: s.id,
        client_name: s.client_name ?? '—',
        country: s.country_name ?? '',
        provider: s.provider_name ?? '',
        recommended_plan:
          typeof s.recommended_plan === 'string' && s.recommended_plan ? s.recommended_plan : '—',
        total_cost:
          typeof s.total_annual_cost === 'number'
            ? s.total_annual_cost
            : Number(s.total_annual_cost ?? 0),
        has_summary: Boolean(s.has_summary),
        created_at: typeof s.created_at === 'string' ? s.created_at : '',
      }));
      kpiRecentScenarioCount = recentScenarios.length;
    }
    if (dash.data.document_analyses?.mock && !adminNotice) {
      adminNotice =
        'Document analysis data is mock/fixture until the Documents Agent is connected to the API.';
    }
  } else if (!dash.ok) {
    const suffix = ` Plan Advisor unreachable (HTTP ${dash.status}). Showing demo placeholders.`;
    adminNotice = (adminNotice ? adminNotice.trim() + suffix : suffix.trim());
  }
}

const statusColor: Record<string, string> = {
  active: 'green',
  draft: 'gray',
  pending_approval: 'amber',
  archived: 'red',
};
---

<AdminLayout title="Dashboard" notice={adminNotice} analysesPendingCount={kpiAnalysesPending}>
  <div class="page-admin-dashboard">
  <!-- KPI row -->
  <div class="kpi-grid">
    <div class="kpi">
      <div class="kpi-icon green">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
      </div>
      <div>
        <p class="kpi-value">{kpiActive}</p>
        <p class="kpi-label">Active Profiles</p>
      </div>
    </div>

    <div class="kpi">
      <div class="kpi-icon amber">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>
      <div>
        <p class="kpi-value">{kpiInProgress}</p>
        <p class="kpi-label">Profiles in Progress</p>
      </div>
    </div>

    <div class="kpi">
      <div class="kpi-icon indigo">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/>
        </svg>
      </div>
      <div>
        <p class="kpi-value">{kpiAnalysesPending}</p>
        <p class="kpi-label">Analyses to Review</p>
      </div>
    </div>

    <div class="kpi">
      <div class="kpi-icon blue">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
      </div>
      <div>
        <p class="kpi-value">{kpiRecentScenarioCount}</p>
        <p class="kpi-label">Recent Scenarios</p>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <section class="section">
    <h2 class="section-title">Quick Actions</h2>
    <div class="actions-grid">
      <a href="/admin/countries/new" class="action-card admin">
        <div class="action-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
        </div>
        <div>
          <p class="action-title">New Country / Provider</p>
          <p class="action-desc">Create a new country–provider profile</p>
        </div>
      </a>

      <a href={reviewQuickHref} class="action-card amber">
        <div class="action-icon amber">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 11 12 14 22 4"/>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
        </div>
        <div>
          <p class="action-title">Review Pending Analysis</p>
          <p class="action-desc">{pendingAnalyses.length} analysis waiting for approval</p>
        </div>
      </a>

      <a href="/countries" class="action-card gray">
        <div class="action-icon gray">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
        </div>
        <div>
          <p class="action-title">All Countries</p>
          <p class="action-desc">View and manage all configured profiles</p>
        </div>
      </a>

      <a href="/admin/settings" class="action-card gray">
        <div class="action-icon gray">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div>
          <p class="action-title">Manage Users</p>
          <p class="action-desc">Add or update user accounts and roles</p>
        </div>
      </a>
    </div>
  </section>

  <div class="two-col">
    <!-- All countries -->
    <section class="section panel">
      <div class="panel-head">
        <h2 class="section-title" style="margin-bottom:0">Countries & Providers</h2>
        <a href="/countries" class="link-more">View all →</a>
      </div>
      <table class="table">
        <thead>
          <tr>
            <th>Country</th>
            <th>Provider</th>
            <th>Version</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {tableProfiles.map(p => (
            <tr>
              <td><span class="flag-code">{p.country.code}</span> {p.country.name}</td>
              <td>{p.provider.name} <span class="tag">{p.provider.type}</span></td>
              <td class="mono">{p.version}</td>
              <td><span class={`badge badge-${statusColor[p.status]}`}>{p.status.replace('_', ' ')}</span></td>
              <td>
                {p.status === 'draft'
                  ? <a href={`/admin/countries/${p.id}/setup`} class="tbl-link">Continue setup</a>
                  : p.status === 'pending_approval' && p.analysis_id
                  ? <a href={`/admin/analyses/${p.analysis_id}`} class="tbl-link">Review analysis</a>
                  : <a href={`/countries`} class="tbl-link">View</a>
                }
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- Recent uploaded documents -->
    <div class="right-col">
      <section class="section panel">
        <div class="panel-head">
          <h2 class="section-title" style="margin-bottom:0">Recent Documents</h2>
          <a href="/countries" class="link-more">View all →</a>
        </div>
        <ul class="doc-list">
          {recentDocs.map(doc => (
            <li class="doc-item">
              <div class={`doc-icon doc-${doc.copyright_status}`}>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                </svg>
              </div>
              <div class="doc-info">
                <p class="doc-name">{doc.filename}</p>
                <p class="doc-meta">{formatDocUploadedAt(doc.uploaded_at)} · <span class={`doc-copyright doc-${doc.copyright_status}`}>{doc.copyright_status}</span></p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- AI Analyses pending -->
      <section class="section panel" style="margin-top: 0">
        <div class="panel-head">
          <h2 class="section-title" style="margin-bottom:0">AI Analyses</h2>
          <a href="/admin/analyses" class="link-more">View all →</a>
        </div>
        <ul class="analysis-list">
          {mockAnalysesList.map(a => (
            <li class="analysis-item">
              <div class="analysis-info">
                <p class="analysis-name">{a.country} / {a.provider}</p>
                <p class="analysis-meta">{a.rules_proposed} rules · {a.plans_proposed} plans · {a.created_at}</p>
              </div>
              <div class="analysis-right">
                {a.status === 'pending_review'
                  ? <a href={`/admin/analyses/${a.id}`} class="badge badge-amber" style="cursor:pointer">Review</a>
                  : <span class="badge badge-green">Done</span>
                }
              </div>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>

  <!-- Recent Scenarios -->
  <section class="section panel">
    <div class="panel-head">
      <h2 class="section-title" style="margin-bottom:0">Recent Scenarios</h2>
      <a href="/scenarios" class="link-more">View all →</a>
    </div>
    <table class="table">
      <thead>
        <tr>
          <th>Client</th>
          <th>Country / Provider</th>
          <th>Recommended Plan</th>
          <th>Total Cost</th>
          <th>AI Summary</th>
          <th>Date</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {recentScenarios.map(s => (
          <tr>
            <td class="bold">{s.client_name}</td>
            <td>{s.country} / {s.provider}</td>
            <td>{s.recommended_plan}</td>
            <td class="mono">€{s.total_cost.toLocaleString()}</td>
            <td>{s.has_summary ? <span class="badge badge-green">Generated</span> : <span class="badge badge-gray">—</span>}</td>
            <td class="muted">{formatScenarioDate(s.created_at)}</td>
            <td><a href={`/scenarios/${s.id}`} class="tbl-link">View</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
  </div>
</AdminLayout>

