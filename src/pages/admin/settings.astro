---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession, isAdminRole } from '../../lib/session';
import {
  canUsePlanAdvisorApi,
  paFetchJson,
} from '../../lib/pa-api';
import { getFreshSupabaseAccessToken } from '../../lib/supabase-session';
import '../../styles/pages/admin-settings.css';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');
if (!isAdminRole(session.role)) return Astro.redirect('/dashboard');

let paToken: string | null = null;
if (session.supabaseAccessToken?.trim()) {
  const fresh = await getFreshSupabaseAccessToken(Astro.cookies);
  if (fresh.ok) paToken = fresh.accessToken;
}

const apiReady = canUsePlanAdvisorApi(session);

type ApiUserRow = {
  id: string;
  email: string;
  full_name: string | null;
  role: string;
  active: boolean;
  created_at: string;
  company_id: string | null;
  company_name: string | null;
  company_type: string | null;
  ai_calls_this_month?: number | null;
};

type AdminUsersTableRow = {
  id: string;
  email: string;
  full_name: string;
  role: 'admin' | 'internal' | 'client';
  company: string;
  company_type: 'internal' | 'client';
  active: boolean;
  created_at: string;
  ai_calls_used: number;
  ai_limit: number | null;
};

let adminNotice: string | null = null;
let users: AdminUsersTableRow[] = [];

function formatUserCreatedAt(raw: string): string {
  const d = new Date(raw);
  if (Number.isNaN(d.getTime())) return raw;
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}

function mapApiUser(r: ApiUserRow): AdminUsersTableRow {
  const displayName = (r.full_name?.trim() || r.email || 'User').trim();
  const coType =
    r.company_type === 'internal' || r.company_type === 'client' ? r.company_type : 'internal';
  const role =
    r.role === 'admin' || r.role === 'internal' || r.role === 'client' ? r.role : 'client';
  const aiCalls = Number(r.ai_calls_this_month ?? 0);
  return {
    id: r.id,
    email: r.email,
    full_name: displayName,
    role,
    company: r.company_name?.trim() || '—',
    company_type: coType,
    active: Boolean(r.active),
    created_at: formatUserCreatedAt(r.created_at),
    ai_calls_used: aiCalls,
    ai_limit: role === 'client' ? 10 : null,
  };
}

if (!session.supabaseAccessToken) {
  adminNotice =
    'Demo session (no JWT). Configure Supabase sign-in + API_BASE_URL for live user list.';
} else if (!(import.meta.env.API_BASE_URL ?? '').trim()) {
  adminNotice = 'Set API_BASE_URL to reach Plan Advisor from this app.';
} else if (!paToken) {
  adminNotice =
    'Session expired. Please sign out and sign in again so a fresh Supabase token is stored.';
}

if (apiReady && paToken && (import.meta.env.API_BASE_URL ?? '').trim().length > 0) {
  const res = await paFetchJson<ApiUserRow[]>('/admin/users', paToken);
  if (res.ok && Array.isArray(res.data)) {
    users = res.data.map(mapApiUser);
  } else if (!res.ok) {
    const suffix = ` Plan Advisor unreachable (HTTP ${res.status}).`;
    adminNotice = (adminNotice ? adminNotice.trim() + suffix : suffix.trim());
  }
}

const roleMeta: Record<string, { label: string; cls: string }> = {
  admin:    { label: 'Admin',    cls: 'r-admin' },
  internal: { label: 'Internal', cls: 'r-internal' },
  client:   { label: 'Client',   cls: 'r-client' },
};
---

<AdminLayout
  title="Settings & Users"
  breadcrumbs={[{ label: 'Admin' }, { label: 'Settings & Users' }]}
  notice={adminNotice}
>
  <div class="page-admin-settings settings-layout">
    <!-- Left: User management -->
    <div class="main-col">
      <!-- Users table -->
      <div class="panel">
        <div class="panel-head">
          <div>
            <h2 class="panel-title">User Accounts</h2>
            <p class="panel-subtitle">{users.length} users · {users.filter(u => u.active).length} active</p>
          </div>
          <a href="/admin/settings/new-user" class="btn-new-user">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            New User
          </a>
        </div>

        {users.length === 0 ? (
          <div class="empty-state">No users created yet</div>
        ) : (
        <table class="table">
          <thead>
            <tr>
              <th>User</th>
              <th>Role</th>
              <th>Company</th>
              <th>Status</th>
              <th>Created</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {users.map(user => (
              <tr class={!user.active ? 'row-inactive' : ''}>
                <td>
                  <div class="user-cell">
                    <div class={`user-avatar ua-${user.role}`}>{(user.full_name?.trim() || user.email).charAt(0)}</div>
                    <div>
                      <p class="user-name">{user.full_name}</p>
                      <p class="user-email">{user.email}</p>
                    </div>
                  </div>
                </td>
                <td>
                  <span class={`role-badge ${(roleMeta[user.role] ?? roleMeta.client).cls}`}>{(roleMeta[user.role] ?? roleMeta.client).label}</span>
                </td>
                <td>
                  <span class="company-name">{user.company}</span>
                  <span class={`company-type ct-${user.company_type}`}>{user.company_type}</span>
                </td>
                <td>
                  {user.active
                    ? <span class="status-dot active">Active</span>
                    : <span class="status-dot inactive">Inactive</span>
                  }
                </td>
                <td class="muted">{user.created_at}</td>
                <td>
                  <div class="row-actions">
                    <!-- TODO: PATCH /admin/users/{user.id} via App 2 API -->
                    <button class="btn-icon" title="Edit user" onclick={`handleEditUser('${user.id}')`}>
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        )}
      </div>

    </div>

    <!-- Right: AI limits + permissions config -->
