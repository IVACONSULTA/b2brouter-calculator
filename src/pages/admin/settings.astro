<script>
  // New User button is now a link to /admin/settings/new-user
  // No JavaScript handler needed - it's a standard anchor tag

  function handleEditUser(userId: string) {
    window.location.href = `/admin/users/${userId}`;
  }

  Object.assign(window, { handleEditUser });
</script>

