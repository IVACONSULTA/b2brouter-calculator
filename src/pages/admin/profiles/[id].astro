---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSession, isAdminRole } from '../../../lib/session';
import {
  canUsePlanAdvisorApi,
  paFetchJson,
} from '../../../lib/pa-api';
import { getFreshSupabaseAccessToken } from '../../../lib/supabase-session';
import '../../../styles/pages/admin-profile-detail.css';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');
if (!isAdminRole(session.role)) return Astro.redirect('/dashboard');

const { id } = Astro.params;
const safeId = id ?? '';

let paToken: string | null = null;
if (session.supabaseAccessToken?.trim()) {
  const fresh = await getFreshSupabaseAccessToken(Astro.cookies);
  if (fresh.ok) paToken = fresh.accessToken;
}

const apiReady = canUsePlanAdvisorApi(session);

type ProfileApiRow = {
  id: string;
  country: { code: string; name: string };
  provider: { name: string; type: string };
  version: string;
  currency: string;
  status: 'active' | 'draft' | 'pending_approval' | 'archived';
  active_from: string | null;
  created_at: string;
  rules_count: number;
  plans_count: number;
  analysis_id: string | null;
};

type AnalysisRule = {
  id: string;
  input_key: string;
  label: string;
  direction: string;
  obligation: string;
  pa_transactions_per_item: number;
  source_document: string;
  status: 'approved' | 'proposed' | 'pending_confirmation' | 'rejected';
};

type AnalysisPlan = {
  id: string;
  plan_name: string;
  annual_fee: number;
  included_pa_transactions: number;
  extra_transaction_cost: number;
  status: 'approved' | 'proposed' | 'rejected';
};

type AnalysisAssumption = {
  id: string;
  key: string;
  value: string;
  status: 'approved' | 'proposed' | 'rejected';
};

type AnalysisConflict = {
  id: string;
  description: string;
  severity: string;
};

type AnalysisDetail = {
  id: string;
  profile_id: string;
  rules: AnalysisRule[];
  plans: AnalysisPlan[];
  assumptions: AnalysisAssumption[];
  conflicts: AnalysisConflict[];
};

let adminNotice: string | null = null;
let profile: ProfileApiRow | null = null;
let analysis: AnalysisDetail | null = null;

if (!session.supabaseAccessToken) {
  adminNotice =
    'Demo session (no JWT). Configure Supabase sign-in + API_BASE_URL for live profile data.';
} else if (!(import.meta.env.API_BASE_URL ?? '').trim()) {
  adminNotice = 'Set API_BASE_URL to reach Plan Advisor from this app.';
} else if (!paToken) {
  adminNotice =
    'Session expired. Please sign out and sign in again so a fresh Supabase token is stored.';
}

if (apiReady && paToken && safeId) {
  try {
    // Fetch profile via proxy
    const profileResponse = await fetch(
      new URL(`/api/pa/admin/profiles/${encodeURIComponent(safeId)}`, Astro.url.origin).toString(),
      {
        headers: {
          'Cookie': Astro.request.headers.get('cookie') || '',
        },
      }
    );

    if (profileResponse.ok) {
      const profileData = await profileResponse.json();
      if (profileData && !profileData.error) {
        // Transform backend response to match frontend types
        profile = {
          id: profileData.id,
          country: {
            code: profileData.country_code,
            name: profileData.country_name,
          },
          provider: {
            name: profileData.provider_name,
            type: profileData.provider_type || 'PA',
          },
          version: profileData.version,
          currency: profileData.currency,
          status: profileData.status,
          active_from: profileData.active_from,
          created_at: profileData.created_at,
          rules_count: profileData.rules?.length || 0,
          plans_count: profileData.plans?.length || 0,
          analysis_id: profileData.analysis_id || null,
        };

        // Transform rules, plans, assumptions from the profile response
        if (profileData.rules && Array.isArray(profileData.rules)) {
          analysis = {
            id: profileData.analysis_id || '',
            profile_id: profileData.id,
            rules: profileData.rules.map((r: any) => ({
              id: r.id,
              input_key: r.input_key,
              label: r.label,
              direction: r.direction,
              obligation: r.obligation,
              pa_transactions_per_item: r.pa_transactions_per_item || 1,
              source_document: r.source_document || '',
              status: r.status || 'proposed',
            })),
            plans: profileData.plans?.map((p: any) => ({
              id: p.id,
              plan_name: p.name,
              annual_fee: p.annual_fee,
              included_pa_transactions: p.included_transactions || 0,
              extra_transaction_cost: p.extra_cost || 0,
              status: p.status || 'proposed',
            })) || [],
            assumptions: profileData.assumptions?.map((a: any) => ({
              id: a.id,
              key: a.key,
              value: a.value,
              status: a.status || 'proposed',
            })) || [],
            conflicts: [], // Backend doesn't return conflicts yet
          };
        }
      }
    } else if (profileResponse.status === 404) {
      adminNotice = 'Profile not found.';
    } else {
      const suffix = ` Plan Advisor unreachable (HTTP ${profileResponse.status}).`;
      adminNotice = (adminNotice ? adminNotice.trim() + suffix : suffix.trim());
    }
  } catch (err) {
    console.error('[Profile Detail] Error fetching profile:', err);
    adminNotice = 'Failed to load profile data. Please try again.';
  }
}

const approvedRules = analysis ? analysis.rules.filter(r => r.status === 'approved') : [];
const approvedPlans = analysis ? analysis.plans.filter(p => p.status === 'approved') : [];
const approvedAssumptions = analysis ? analysis.assumptions.filter(a => a.status === 'approved') : [];
const pendingItems = analysis
  ? analysis.rules.filter(r => r.status !== 'approved' && r.status !== 'rejected').length +
    analysis.plans.filter((p) => !['approved', 'rejected'].includes(p.status)).length
  : 0;

const canActivate = approvedRules.length >= 1 && approvedPlans.length >= 1 && (analysis?.conflicts.length ?? 0) === 0;

const isAlreadyActive = profile?.status === 'active';
---

<AdminLayout
  title={profile ? `Profile — ${profile.country.name} / ${profile.provider.name}` : 'Profile Not Found'}
  breadcrumbs={[
    { label: 'Countries', href: '/countries' },
    ...(profile ? [{ label: `${profile.country.name} / ${profile.provider.name}` }] : []),
    ...(profile ? [{ label: `Profile ${profile.version}` }] : []),
  ]}
  notice={adminNotice}
>
  <div class="page-admin-profile-detail">
  {profile === null ? (
    <div class="empty-state">Profile not found or no longer available</div>
  ) : (
    <>
  <!-- Profile header card -->
  <div class="profile-header">
    <div class="ph-left">
      <div class="ph-badge">
        <span class="ph-code">{profile.country.code}</span>
        <div>
          <p class="ph-title">{profile.country.name} · {profile.provider.name} <span class="ph-type">{profile.provider.type}</span></p>
          <p class="ph-version">Version {profile.version} · {profile.currency}</p>
        </div>
      </div>
    </div>
    <div class="ph-right">
      <span class={`status-badge s-${profile.status}`}>{profile.status.replace('_', ' ')}</span>
      {isAlreadyActive
        ? (
          <!-- TODO: POST /admin/profiles/{profile.id}/archive via App 2 API -->
          <button class="btn-archive" onclick="handleArchive()">Archive version</button>
        )
        : (
          <!-- TODO: POST /admin/profiles/{profile.id}/activate via App 2 API -->
          <button
            class={`btn-activate ${canActivate ? '' : 'disabled'}`}
            onclick="handleActivate()"
            disabled={!canActivate}
            title={canActivate ? 'Activate this profile' : 'Complete all required steps before activating'}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            Activate version
          </button>
        )
      }
    </div>
  </div>

  <!-- Activation checklist -->
  <div class="checklist-card">
    <h2 class="checklist-title">Activation Requirements</h2>
    <div class="checklist-grid">
      <div class={`check-item ${approvedRules.length >= 1 ? 'ok' : 'fail'}`}>
        <div class="check-icon">
          {approvedRules.length >= 1
            ? <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            : <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          }
        </div>
        <div>
          <p class="check-label">At least 1 approved rule</p>
          <p class="check-value">{approvedRules.length} approved · {analysis?.rules.length ?? 0} total</p>
        </div>
      </div>

      <div class={`check-item ${approvedPlans.length >= 1 ? 'ok' : 'fail'}`}>
        <div class="check-icon">
          {approvedPlans.length >= 1
            ? <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            : <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          }
        </div>
        <div>
          <p class="check-label">At least 1 approved plan</p>
          <p class="check-value">{approvedPlans.length} approved · {analysis?.plans.length ?? 0} total</p>
        </div>
      </div>

      <div class={`check-item ${(analysis?.conflicts.length ?? 0) === 0 ? 'ok' : 'fail'}`}>
        <div class="check-icon">
          {(analysis?.conflicts.length ?? 0) === 0
            ? <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            : <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          }
        </div>
        <div>
          <p class="check-label">No critical conflicts</p>
          <p class="check-value">{analysis?.conflicts.length ?? 0} conflicts detected</p>
        </div>
      </div>

      <div class={`check-item ${pendingItems === 0 ? 'ok' : 'warn'}`}>
        <div class="check-icon">
          {pendingItems === 0
            ? <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            : <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          }
        </div>
        <div>
          <p class="check-label">All items reviewed (optional)</p>
          <p class="check-value">{pendingItems} item(s) still pending review</p>
        </div>
      </div>
    </div>

    {!canActivate && (
      <div class="cant-activate-notice">
        Complete the requirements above before activating. Go to
        <a href={`/admin/analyses/${profile.analysis_id}`} class="notice-link">Analysis Review →</a>
      </div>
    )}
  </div>

  <div class="two-col">
    <!-- Approved Rules -->
    <section class="section panel">
      <h2 class="section-title">Approved Transaction Rules <span class="count-pill">{approvedRules.length}</span></h2>
      {approvedRules.length === 0
        ? <p class="empty-state">No rules approved yet. Go to <a href={`/admin/analyses/${profile.analysis_id}`} class="inline-link">Analysis Review</a>.</p>
        : (
          <table class="table">
            <thead>
              <tr>
                <th>Label</th>
                <th>Direction</th>
                <th>Obligation</th>
                <th>×</th>
              </tr>
            </thead>
            <tbody>
              {approvedRules.map(r => (
                <tr>
                  <td><span class="rule-key">{r.input_key}</span><br /><span class="rule-label">{r.label}</span></td>
                  <td><span class="pill">{r.direction}</span></td>
                  <td><span class="pill">{r.obligation}</span></td>
                  <td class="multiplier">{r.pa_transactions_per_item}×</td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }
    </section>

    <!-- Approved Plans -->
    <section class="section panel">
      <h2 class="section-title">Approved Plans <span class="count-pill">{approvedPlans.length}</span></h2>
      {approvedPlans.length === 0
        ? <p class="empty-state">No plans approved yet.</p>
        : (
          <div class="plans-list">
            {approvedPlans.map(p => (
              <div class="plan-item">
                <div class="plan-name">{p.plan_name}</div>
                <div class="plan-detail">
                  <span>€{p.annual_fee.toLocaleString()}/yr</span>
                  <span class="sep">·</span>
                  <span>{p.included_pa_transactions.toLocaleString()} transactions included</span>
                  <span class="sep">·</span>
                  <span>€{p.extra_transaction_cost}/extra</span>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </section>
  </div>

  <!-- Approved assumptions -->
  {approvedAssumptions.length > 0 && (
    <section class="section panel">
      <h2 class="section-title">Approved Business Assumptions <span class="count-pill">{approvedAssumptions.length}</span></h2>
      <div class="assumptions-grid">
        {approvedAssumptions.map(a => (
          <div class="assumption-item">
            <code class="ak">{a.key}</code>
            <span class="av">{a.value}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Confirmation modal (hidden, shown via JS) -->
  <div id="activate-modal" class="modal-overlay" style="display:none">
    <div class="modal">
      <h3 class="modal-title">Activate Profile</h3>
      <p class="modal-body">
        You are about to activate <strong>{profile.country.name} / {profile.provider.name} {profile.version}</strong>.
        <br /><br />
        This will make the calculator available for all users with active countries permission.
        {profile.status === 'active'
          ? ' The current active version will be archived.'
          : ''
        }
      </p>
      <div class="modal-actions">
        <button class="btn-cancel" onclick="closeModal()">Cancel</button>
        <!-- TODO: POST /admin/profiles/{profile.id}/activate via App 2 API -->
        <button class="btn-confirm" onclick="confirmActivate()">
          Confirm Activation
        </button>
      </div>
      </div>
    </div>
    </>
  )}
  </div>
</AdminLayout>

<script>
  function handleActivate() {
    const modal = document.getElementById('activate-modal')!;
    modal.style.display = 'flex';
  }

  function closeModal() {
    const modal = document.getElementById('activate-modal')!;
    modal.style.display = 'none';
  }

  function confirmActivate() {
    // TODO: POST to API_BASE_URL/admin/profiles/{id}/activate
    alert('TODO: POST API_BASE_URL/admin/profiles/{id}/activate\nOn success: redirect to /countries');
    closeModal();
  }

  function handleArchive() {
    if (confirm('Archive this version? It will no longer be active.')) {
      // TODO: POST to API_BASE_URL/admin/profiles/{id}/archive
      alert('TODO: POST API_BASE_URL/admin/profiles/{id}/archive');
    }
  }

  Object.assign(window, { handleActivate, closeModal, confirmActivate, handleArchive });
</script>

