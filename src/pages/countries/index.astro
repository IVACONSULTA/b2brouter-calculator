---
import AdminLayout from '../../layouts/AdminLayout.astro';
import UserLayout from '../../layouts/UserLayout.astro';
import { getSession } from '../../lib/session';
import { paFetchJson } from '../../lib/pa-api';
import { getFreshSupabaseAccessToken } from '../../lib/supabase-session';
import { DUMMY_PROFILES, DUMMY_ACTIVE_PROFILES } from '../../lib/dummy-data';
import '../../styles/pages/countries.css';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/');

let paToken: string | null = null;
if (session.supabaseAccessToken?.trim()) {
  const fresh = await getFreshSupabaseAccessToken(Astro.cookies);
  if (fresh.ok) paToken = fresh.accessToken;
}

const isAdmin    = session.role === 'admin';
const isInternal = session.role === 'internal';

type PaViewer = { displayName: string; subtitle: string };
let paViewer: PaViewer | null = null;
let paNotice: string | null = null;
let adminNotice: string | null = null;

type AdminProfileApiRow = {
  id: string;
  version: string;
  status: string;
  currency: string;
  active_from?: string | null;
  created_at: string;
  country_code: string;
  country_name: string;
  provider_name: string;
  provider_type?: string | null;
  rules_count?: number | null;
  plans_count?: number | null;
};

type CountryApiRow = { id: string; code: string; name: string };
type ProviderApiRow = { id: string; name: string; type: string };

const PROFILE_STATUSES = new Set(['draft', 'pending_approval', 'active', 'archived']);

function isoDateOnly(v: unknown): string | null {
  if (v == null) return null;
  if (typeof v === 'string' && v.length) {
    return v.length >= 10 ? v.slice(0, 10) : v;
  }
  return null;
}

function mapAdminProfileRow(row: AdminProfileApiRow): (typeof DUMMY_PROFILES)[number] {
  const st = row.status;
  const status = PROFILE_STATUSES.has(st)
    ? (st as (typeof DUMMY_PROFILES)[number]['status'])
    : 'draft';

  const mapped = {
    id: String(row.id),
    country: {
      code: row.country_code ?? '—',
      name: row.country_name ?? '',
    },
    provider: {
      name: row.provider_name ?? '',
      type: row.provider_type ?? '',
    },
    version: String(row.version ?? ''),
    currency: String(row.currency ?? 'EUR'),
    status,
    active_from: isoDateOnly(row.active_from),
    created_at: isoDateOnly(row.created_at) ?? '',
    rules_count: Number(row.rules_count ?? 0),
    plans_count: Number(row.plans_count ?? 0),
    analysis_id: null,
  };
  return mapped as (typeof DUMMY_PROFILES)[number];
}

let activeProfiles = DUMMY_ACTIVE_PROFILES;

let profiles = DUMMY_PROFILES;
/** When true, active profiles are loaded in the browser via `GET /api/pa/available-countries` (visible in DevTools) which proxies to Plan Advisor. */
let loadActiveProfilesInBrowser = false;

if (isAdmin) {
  const base = (import.meta.env.API_BASE_URL ?? '').trim();

  if (!base) {
    adminNotice =
      'Set API_BASE_URL (and PA_PLAN_API_KEY when the API enforces it) to load profiles, countries, and providers from Plan Advisor.';
  } else if (!session.supabaseAccessToken?.trim()) {
    adminNotice =
      'Sign in with Supabase so this app can send a Bearer token to Plan Advisor and load catalog data.';
  } else if (!paToken) {
    adminNotice =
      'Session expired. Please sign out and sign in again so a fresh Supabase token is stored.';
  } else {
    const [pr, cRes, pRes] = await Promise.all([
      paFetchJson<AdminProfileApiRow[]>('/admin/profiles', paToken),
      paFetchJson<CountryApiRow[]>('/countries', paToken),
      paFetchJson<ProviderApiRow[]>('/providers', paToken),
    ]);

    const failed: string[] = [];
    if (pr.ok) {
      profiles = pr.data.map(mapAdminProfileRow);
    } else {
      failed.push(`profiles (HTTP ${pr.status})`);
    }
    if (!cRes.ok) failed.push(`countries (HTTP ${cRes.status})`);
    if (!pRes.ok) failed.push(`providers (HTTP ${pRes.status})`);

    if (failed.length) {
      adminNotice = `Plan Advisor: could not load ${failed.join(', ')}. Showing demo or partial data.`;
    }
  }
}

const statusMeta: Record<string, { label: string; cls: string }> = {
  active:           { label: 'Active',           cls: 'badge-green' },
  pending_approval: { label: 'Pending Approval',  cls: 'badge-amber' },
  draft:            { label: 'Draft',             cls: 'badge-gray'  },
  archived:         { label: 'Archived',          cls: 'badge-red'   },
};

const activeCount  = profiles.filter(p => p.status === 'active').length;
const pendingCount = profiles.filter(p => p.status === 'pending_approval').length;
const draftCount   = profiles.filter(p => p.status === 'draft').length;

if (!isAdmin) {
  if (!session.supabaseAccessToken) {
    paNotice =
      'Demo session (no JWT). Sign in with Supabase, set API_BASE_URL, and PA_PLAN_API_KEY (when the API enforces it) for live profiles.';
  } else if (!(import.meta.env.API_BASE_URL ?? '').trim()) {
    paNotice = 'Set API_BASE_URL to load active profiles from Plan Advisor.';
  } else if (!paToken) {
    paNotice =
      'Session expired. Please sign out and sign in again so a fresh Supabase token is stored.';
  } else {
    const me = await paFetchJson<{ full_name?: string | null; email?: string; company_name?: string | null }>(
      '/me',
      paToken,
    );
    if (me.ok) {
      paViewer = {
        displayName:
          (me.data.full_name?.trim() || me.data.email || session.name)?.trim() || session.name,
        subtitle: [me.data.email, me.data.company_name].filter(Boolean).join(' · '),
      };
    }

    loadActiveProfilesInBrowser = true;
    activeProfiles = [];
  }
}
---

{isAdmin && (
  <AdminLayout
    title="Countries & Providers"
    breadcrumbs={[{ label: 'Admin' }, { label: 'Countries & Providers' }]}
    notice={adminNotice}
  >
    <div class="page-countries">
    <!-- Filter strip -->
    <div class="filter-bar">
      <div class="filter-tabs" id="filter-tabs">
        <button class="filter-tab active" data-filter="all">All <span class="count">{profiles.length}</span></button>
        <button class="filter-tab" data-filter="active">Active <span class="count">{activeCount}</span></button>
        <button class="filter-tab" data-filter="pending_approval">Pending <span class="count">{pendingCount}</span></button>
        <button class="filter-tab" data-filter="draft">Draft <span class="count">{draftCount}</span></button>
      </div>
      <div class="filter-right">
        <div class="search-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input type="search" id="search-input" placeholder="Search country or provider…" class="search-input" />
        </div>
        <a href="/admin/countries/new" class="btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          New Profile
        </a>
      </div>
    </div>

    <!-- Table -->
    <div class="table-wrap">
      <table class="table" id="profiles-table">
        <thead>
          <tr>
            <th>Country</th>
            <th>Provider / Type</th>
            <th>Version</th>
            <th>Status</th>
            <th>Active From</th>
            <th>Rules</th>
            <th>Plans</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {profiles.map(p => (
            <tr data-status={p.status} data-search={`${p.country.name} ${p.provider.name}`.toLowerCase()}>
              <td>
                <div class="country-cell">
                  <span class="code-pill">{p.country.code}</span>
                  <span class="country-name">{p.country.name}</span>
                </div>
              </td>
              <td>
                <span class="provider-name">{p.provider.name}</span>
                <span class="type-tag">{p.provider.type}</span>
              </td>
              <td><span class="version-pill">{p.version}</span></td>
              <td>
                <span class={`badge ${statusMeta[p.status].cls}`}>{statusMeta[p.status].label}</span>
              </td>
              <td class="muted">{p.active_from ?? '—'}</td>
              <td class="center">{p.rules_count}</td>
              <td class="center">{p.plans_count}</td>
              <td>
                <div class="action-row">
                  {p.status === 'draft' && (
                    <>
                      <a href={`/admin/countries/${p.id}/setup`} class="btn-action">Setup</a>
                      <a href={`/admin/countries/${p.id}/documents`} class="btn-action">Docs</a>
                    </>
                  )}
                  {p.status === 'pending_approval' && p.analysis_id && (
                    <a href={`/admin/analyses/${p.analysis_id}`} class="btn-action btn-amber">Review AI</a>
                  )}
                  {(p.status === 'active' || p.status === 'pending_approval') && (
                    <a href={`/admin/profiles/${p.id}`} class="btn-action">Profile</a>
                  )}
                  {p.status === 'archived' && (
                    <span class="muted" style="font-size:0.75rem">Archived</span>
                  )}
                  {p.status !== 'active' && (
                    <button
                      class="btn-delete"
                      title="Delete profile"
                      data-profile-id={p.id}
                      data-profile-name={`${p.country.name} × ${p.provider.name} (${p.version})`}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                      </svg>
                    </button>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    </div>
  </AdminLayout>
)}

{!isAdmin && (
  <UserLayout
    title="Countries & Providers"
    breadcrumbs={[{ label: 'Home', href: '/dashboard' }, { label: 'Countries' }]}
    paViewer={paViewer}
    paNotice={paNotice}
  >
    <div class="page-countries">
    <div class="u-header">
      <div>
        <h2 class="u-heading">Active Profiles</h2>
        <p class="u-sub">Select a country/provider to start a calculation. Only active profiles are available.</p>
      </div>
      <div class="u-search-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="search" id="u-search" placeholder="Search country or provider…" class="u-search-input" />
      </div>
    </div>

    <div class="u-stats-row">
      <div class="u-stat">
        <span class="u-stat-val" id="u-stat-active-count">{loadActiveProfilesInBrowser ? '—' : activeProfiles.length}</span>
        <span class="u-stat-label">Active Profiles</span>
      </div>
      <div class="u-stat">
        <span class="u-stat-val" id="u-stat-country-count">{loadActiveProfilesInBrowser ? '—' : [...new Set(activeProfiles.map(p => p.country.name))].length}</span>
        <span class="u-stat-label">Countries</span>
      </div>
      <div class="u-stat">
        <span class="u-stat-val" id="u-stat-provider-count">{loadActiveProfilesInBrowser ? '—' : [...new Set(activeProfiles.map(p => p.provider.name))].length}</span>
        <span class="u-stat-label">Providers</span>
      </div>
    </div>

    <!-- Active profiles table -->
    <div class="u-table-wrap">
      <table class="u-table" id="u-profiles-table">
        <thead>
          <tr>
            <th>Country</th>
            <th>Provider</th>
            <th>Version</th>
            <th>Rules</th>
            <th>Plans</th>
            <th>Active Since</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="u-profiles-tbody" data-load-profiles={loadActiveProfilesInBrowser ? '1' : undefined}>
          {loadActiveProfilesInBrowser ? (
            <tr>
              <td colspan="7" class="u-muted">Loading active profiles…</td>
            </tr>
          ) : (
            activeProfiles.map(p => (
            <tr data-search={`${p.country.name} ${p.provider.name}`.toLowerCase()}>
              <td>
                <div class="u-country-cell">
                  <span class="u-code-pill">{p.country.code}</span>
                  <span class="u-country-name">{p.country.name}</span>
                </div>
              </td>
              <td>
                <span class="u-provider-name">{p.provider.name}</span>
                <span class="u-type-tag">{p.provider.type}</span>
              </td>
              <td><span class="u-version-pill">{p.version}</span></td>
              <td class="u-center">{p.rules_count}</td>
              <td class="u-center">{p.plans_count}</td>
              <td class="u-muted">{p.active_from ?? '—'}</td>
              <td>
                <!-- TODO: GET /calculator/profile/{p.id} → loads dynamic transaction rule inputs -->
                <a href={`/calculator/${p.id}`} class="u-calc-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="2" width="16" height="20" rx="2"/>
                    <line x1="8" y1="10" x2="12" y2="10"/><line x1="12" y1="6" x2="12" y2="14"/>
                    <line x1="8" y1="18" x2="16" y2="18"/><line x1="8" y1="14" x2="10" y2="14"/>
                  </svg>
                  Calculate
                </a>
              </td>
            </tr>
          ))
          )}
        </tbody>
      </table>
    </div>

    {isInternal && (
      <div class="internal-note">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>As an internal user, you can view profiles in pending or draft state. <a href="/admin/dashboard">Switch to Admin view</a> to manage them.</span>
      </div>
    )}
    </div>
  </UserLayout>
)}

<script>
  function esc(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  }

  /** Plan Advisor returns `{ error, message, hint, supabase_user_id }` on 403 — show more than `error` alone. */
  function formatPlanAdvisorError(payload: unknown, status: number, statusText: string): string {
    if (payload == null) return `${status} ${statusText}`;
    if (typeof payload === 'string') return payload;
    if (typeof payload !== 'object') return String(payload);
    const o = payload as Record<string, unknown>;
    const summary =
      (typeof o.message === 'string' && o.message.trim()) ||
      (typeof o.error === 'string' && o.error.trim()) ||
      statusText;
    const parts = [`HTTP ${status}: ${summary}`];
    if (typeof o.hint === 'string' && o.hint.trim()) {
      parts.push(o.hint.trim());
    }
    if (typeof o.supabase_user_id === 'string' && o.supabase_user_id.trim()) {
      parts.push(`Supabase user id (set users_profile.id to this): ${o.supabase_user_id.trim()}`);
    }
    return parts.join(' ');
  }

  // Admin filter
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const rows = document.querySelectorAll<HTMLTableRowElement>('#profiles-table tbody tr');
  const search = document.getElementById('search-input') as HTMLInputElement | null;

  let activeFilter = 'all';
  let searchQuery  = '';

  function applyFilters() {
    rows.forEach(row => {
      const status     = row.dataset.status ?? '';
      const term       = row.dataset.search ?? '';
      const matchFilter = activeFilter === 'all' || status === activeFilter;
      const matchSearch = term.includes(searchQuery);
      row.style.display = matchFilter && matchSearch ? '' : 'none';
    });
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      activeFilter = tab.dataset.filter ?? 'all';
      applyFilters();
    });
  });

  if (search) {
    search.addEventListener('input', () => {
      searchQuery = search.value.toLowerCase();
      applyFilters();
    });
  }

  // User search (re-query rows so client-loaded profiles stay filterable)
  const uSearch = document.getElementById('u-search') as HTMLInputElement | null;

  if (uSearch) {
    uSearch.addEventListener('input', () => {
      const q = uSearch.value.toLowerCase();
      document.querySelectorAll<HTMLTableRowElement>('#u-profiles-table tbody tr').forEach(row => {
        const term = row.dataset.search ?? '';
        row.style.display = term.includes(q) ? '' : 'none';
      });
    });
  }

  /** Load active profiles in the browser so DevTools shows `GET /api/pa/available-countries`; Astro proxies to Plan Advisor `/api/calculator/available-countries`. */
  const uTbody = document.getElementById('u-profiles-tbody');
  if (uTbody?.dataset.loadProfiles === '1') {
    fetch('/api/pa/available-countries', { credentials: 'same-origin' })
      .then(async (res) => {
        const raw = await res.text();
        let payload: unknown = null;
        if (raw.length) {
          try {
            payload = JSON.parse(raw);
          } catch {
            payload = null;
          }
        }
        if (!res.ok) {
          const detail = formatPlanAdvisorError(payload, res.status, res.statusText);
          uTbody.innerHTML = `<tr><td colspan="7" class="u-muted u-profiles-api-err">${esc(detail)}</td></tr>`;
          return;
        }
        const rows = Array.isArray(payload) ? payload : [];

        const countryNames = new Set<string>();
        const providerNames = new Set<string>();
        const frag = document.createDocumentFragment();
        for (const raw of rows) {
          const p = raw as Record<string, unknown>;
          const cname = typeof p.country_name === 'string' ? p.country_name : '';
          const pname = typeof p.provider_name === 'string' ? p.provider_name : '';
          countryNames.add(cname);
          providerNames.add(pname);
          const code = esc(typeof p.country_code === 'string' ? p.country_code : '—');
          const tr = document.createElement('tr');
          tr.dataset.search = `${cname} ${pname}`.toLowerCase();
          const af = p.active_from;
          const fromRaw =
            typeof af === 'string' && af.length ? esc(af.slice(0, 10)) : '—';
          const ver = typeof p.version === 'string' ? p.version : '';
          const ptype = typeof p.provider_type === 'string' ? p.provider_type : '';
          const pid = typeof p.profile_id === 'string' ? p.profile_id : '';
          tr.innerHTML = `
            <td>
              <div class="u-country-cell">
                <span class="u-code-pill">${code}</span>
                <span class="u-country-name">${esc(cname)}</span>
              </div>
            </td>
            <td>
              <span class="u-provider-name">${esc(pname)}</span>
              <span class="u-type-tag">${esc(ptype)}</span>
            </td>
            <td><span class="u-version-pill">${esc(ver)}</span></td>
            <td class="u-center">${Number(p.rules_count ?? 0)}</td>
            <td class="u-center">${Number(p.plans_count ?? 0)}</td>
            <td class="u-muted">${fromRaw}</td>
            <td>
              <a href="/calculator/${encodeURIComponent(pid)}" class="u-calc-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="2" width="16" height="20" rx="2"/>
                  <line x1="8" y1="10" x2="12" y2="10"/><line x1="12" y1="6" x2="12" y2="14"/>
                  <line x1="8" y1="18" x2="16" y2="18"/><line x1="8" y1="14" x2="10" y2="14"/>
                </svg>
                Calculate
              </a>
            </td>`;
          frag.appendChild(tr);
        }
        uTbody.replaceChildren(frag);

        const n = (id: string, v: number) => {
          const el = document.getElementById(id);
          if (el) el.textContent = String(v);
        };
        n('u-stat-active-count', rows.length);
        n('u-stat-country-count', countryNames.size);
        n('u-stat-provider-count', providerNames.size);
      })
      .catch((err: unknown) => {
        const message = err instanceof Error ? err.message : String(err);
        uTbody.innerHTML = `<tr><td colspan="7" class="u-muted">Request failed: ${esc(message)}</td></tr>`;
      });
  }

  // Delete profile functionality (admin only)
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const deleteBtn = target.closest('.btn-delete') as HTMLButtonElement | null;
    
    if (!deleteBtn) return;

    const profileId = deleteBtn.dataset.profileId;
    const profileName = deleteBtn.dataset.profileName || 'this profile';

    if (!profileId) {
      alert('Profile ID is missing.');
      return;
    }

    const confirmed = confirm(
      `Are you sure you want to delete ${profileName}?\n\nThis action cannot be undone and will delete all related documents, rules, plans, and assumptions.`
    );

    if (!confirmed) return;

    deleteBtn.disabled = true;
    deleteBtn.style.opacity = '0.5';
    deleteBtn.style.cursor = 'wait';

    try {
      const response = await fetch(`/api/pa/admin/profiles/delete?id=${encodeURIComponent(profileId)}`, {
        method: 'DELETE',
        credentials: 'same-origin',
      });

      const raw = await response.text();
      let payload: unknown = null;
      if (raw.length) {
        try {
          payload = JSON.parse(raw);
        } catch {
          payload = null;
        }
      }

      if (!response.ok) {
        const detail = formatPlanAdvisorError(payload, response.status, response.statusText);
        alert(`Delete failed: ${detail}`);
        deleteBtn.disabled = false;
        deleteBtn.style.opacity = '';
        deleteBtn.style.cursor = '';
        return;
      }

      // Remove the row from the table
      const row = deleteBtn.closest('tr');
      if (row) {
        row.style.transition = 'opacity 0.3s';
        row.style.opacity = '0';
        setTimeout(() => row.remove(), 300);
      }

      // Update counts
      const statusFilter = row?.dataset.status;
      if (statusFilter) {
        const countBadge = document.querySelector(`.filter-tab[data-filter="${statusFilter}"] .count`);
        if (countBadge) {
          const current = parseInt(countBadge.textContent || '0', 10);
          countBadge.textContent = String(Math.max(0, current - 1));
        }
      }

      const allCountBadge = document.querySelector('.filter-tab[data-filter="all"] .count');
      if (allCountBadge) {
        const current = parseInt(allCountBadge.textContent || '0', 10);
        allCountBadge.textContent = String(Math.max(0, current - 1));
      }

    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : String(err);
      alert(`Request failed: ${message}`);
      deleteBtn.disabled = false;
      deleteBtn.style.opacity = '';
      deleteBtn.style.cursor = '';
    }
  });
</script>

