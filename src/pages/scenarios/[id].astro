---
import UserLayout from '../../layouts/UserLayout.astro';
import SingleScenario from '../../components/SingleScenario.tsx';
import { getSession, isAdminRole } from '../../lib/session';
import {
  canUsePlanAdvisorApi,
  paFetchJson,
} from '../../lib/pa-api';
import { getFreshSupabaseAccessToken } from '../../lib/supabase-session';
import { normalizeScenarioDetail, scenarioFromLegacyDummy, type ScenarioView } from '../../lib/scenario-view';
import {
  DUMMY_SCENARIO_RESULT,
  DUMMY_SCENARIO_RESULT_2,
} from '../../lib/dummy-data';
import ScenarioDeleteModal from '../../components/ScenarioDeleteModal.astro';
import '../../styles/pages/scenario-detail.css';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/customer/login');
if (isAdminRole(session.role)) return Astro.redirect('/admin/dashboard');

let paToken: string | null = null;
if (session.supabaseAccessToken?.trim()) {
  const fresh = await getFreshSupabaseAccessToken(Astro.cookies);
  if (fresh.ok) paToken = fresh.accessToken;
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/scenarios');

type PaViewer = { displayName: string; subtitle: string };
let paViewer: PaViewer | null = null;
let paNotice: string | null = null;

const isInternal = session.role === 'internal';

const allDummy: ScenarioView[] = [
  scenarioFromLegacyDummy(DUMMY_SCENARIO_RESULT),
  scenarioFromLegacyDummy(DUMMY_SCENARIO_RESULT_2),
];

let scenarioView: ScenarioView =
  allDummy.find((s) => s.id === id) ??
  (() => {
    paNotice ??= 'Demo: unknown scenario id — showing a sample scenario.';
    return scenarioFromLegacyDummy(DUMMY_SCENARIO_RESULT);
  })();

/** Loaded from GET /scenarios/:id (not demo fallback). */
let scenarioFromApi = false;

let clientSummaryAllowed = true;

const apiReady = canUsePlanAdvisorApi(session);

if (!session.supabaseAccessToken) {
  paNotice =
    'Demo session (no JWT). Configure Supabase sign-in + API_BASE_URL for live calculator data.';
} else if (!(import.meta.env.API_BASE_URL ?? '').trim()) {
  paNotice = 'Set API_BASE_URL to reach Plan Advisor from this app.';
} else if (!paToken) {
  paNotice =
    'Session expired. Please sign out and sign in again so a fresh Supabase token is stored.';
}

if (
  apiReady &&
  paToken &&
  (import.meta.env.API_BASE_URL ?? '').trim().length > 0
) {
  const me = await paFetchJson<{
    full_name?: string | null;
    email?: string;
    company_name?: string | null;
    client_summary_enabled?: boolean;
  }>('/me', paToken);

  if (me.ok) {
    paViewer = {
      displayName:
        (me.data.full_name?.trim() || me.data.email || session.name)?.trim() || session.name,
      subtitle: [me.data.email, me.data.company_name].filter(Boolean).join(' · '),
    };
    if (me.data.client_summary_enabled === false && session.role === 'client') {
      clientSummaryAllowed = false;
    }
  }

  const row = await paFetchJson<Record<string, unknown>>(
    `/scenarios/${encodeURIComponent(id)}`,
    paToken,
  );
  if (row.ok && row.data) {
    scenarioView = normalizeScenarioDetail(row.data);
    scenarioFromApi = true;
    paNotice = null;
  } else if (row.status === 403 || row.status === 404) {
    return Astro.redirect('/scenarios');
  } else {
    const suffix = ` Plan Advisor unreachable (HTTP ${row.status}). Showing demo scenario.`;
    paNotice = (paNotice ? paNotice.trim() + suffix : suffix.trim());
  }
}

const scenario = scenarioView!;
const date = new Date(scenario.created_at).toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

const canGenerateSummary = isInternal;
const showSummaryBtn = canGenerateSummary || (session.role === 'client' && clientSummaryAllowed);

/** True when the session can refresh/BFF auth (dummy login has no JWT). */
const hasSupabaseToken = Boolean(session.supabaseAccessToken?.trim());

---

<UserLayout
  title={`Scenario: ${scenario.client_name}`}
  paViewer={paViewer}
  paNotice={paNotice}
  breadcrumbs={[
    { label: 'Home', href: '/dashboard' },
    { label: 'Scenarios', href: '/scenarios' },
    { label: scenario.client_name },
  ]}
>
  <SingleScenario
    client:load
    scenario={scenario}
    dateDisplay={date}
    isInternal={isInternal}
    scenarioFromApi={scenarioFromApi}
    showSummaryBtn={showSummaryBtn}
    hasSupabaseToken={hasSupabaseToken}
  />
  <ScenarioDeleteModal />
</UserLayout>
