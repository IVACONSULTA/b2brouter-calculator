---
import UserLayout from '../../layouts/UserLayout.astro';
import { getSession, isAdminRole } from '../../lib/session';
import { paFetchJson, planAdvisorApiBase } from '../../lib/pa-api';
import { getFreshSupabaseAccessToken } from '../../lib/supabase-session';
import { DUMMY_SCENARIOS } from '../../lib/dummy-data';
import ScenarioDeleteModal from '../../components/ScenarioDeleteModal.astro';
import '../../styles/pages/scenarios-index.css';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/customer/login');
if (isAdminRole(session.role)) return Astro.redirect('/admin/dashboard');

let paToken: string | null = null;
if (session.supabaseAccessToken?.trim()) {
  const fresh = await getFreshSupabaseAccessToken(Astro.cookies);
  if (fresh.ok) paToken = fresh.accessToken;
}

const isInternal = session.role === 'internal';

type PaViewer = { displayName: string; subtitle: string };
let paViewer: PaViewer | null = null;
let paNotice: string | null = null;

type ScenarioRow = {
  id: string;
  client_name: string;
  country: string;
  provider: string;
  version: string;
  total_pa_transactions: number | null;
  recommended_plan: string;
  total_cost: number;
  has_summary: boolean;
  created_at: string;
  created_by?: string;
};

type ApiScenarioListItem = {
  id: string;
  client_name?: string | null;
  country_name?: string | null;
  provider_name?: string | null;
  version?: string | null;
  has_summary?: boolean;
  created_at: string;
  created_by_email?: string | null;
  total_pa_transactions?: number | string | null;
  recommended_plan_name?: string | null;
  recommended_total_annual_cost?: number | string | null;
};

function mapDummy(rows: typeof DUMMY_SCENARIOS): ScenarioRow[] {
  return rows.map((s) => ({
    id: s.id,
    client_name: s.client_name,
    country: s.country,
    provider: s.provider,
    version: 'v1.0',
    total_pa_transactions: null,
    recommended_plan: s.recommended_plan,
    total_cost: s.total_cost,
    has_summary: s.has_summary,
    created_at: s.created_at,
    created_by: s.created_by,
  }));
}

/** e.g. 05 May 2026, 14:30:45 (24h, en-GB) */
function formatScenarioTableDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '—';
  const datePart = d.toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
  });
  const timePart = d.toLocaleTimeString('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: false,
  });
  return `${datePart}, ${timePart}`;
}

const dummySubset = isInternal
  ? DUMMY_SCENARIOS
  : DUMMY_SCENARIOS.filter((_, i) => i % 2 === 0);

let scenarios: ScenarioRow[] = mapDummy(dummySubset);
let scenariosLive = false;

if (!session.supabaseAccessToken) {
  paNotice =
    'Demo session (no JWT). Sign in with Supabase + set API_BASE_URL for live scenarios.';
} else if (!(import.meta.env.API_BASE_URL ?? '').trim()) {
  paNotice = 'Set API_BASE_URL to load scenarios from Plan Advisor.';
} else if (!paToken) {
  paNotice =
    'Session expired. Please sign out and sign in again so a fresh Supabase token is stored.';
} else {
  const me = await paFetchJson<{ full_name?: string | null; email?: string; company_name?: string | null }>(
    '/me',
    paToken,
  );
  if (me.ok) {
    paViewer = {
      displayName:
        (me.data.full_name?.trim() || me.data.email || session.name)?.trim() || session.name,
      subtitle: [me.data.email, me.data.company_name].filter(Boolean).join(' · '),
    };
  }

  const list = await paFetchJson<ApiScenarioListItem[]>('/scenarios', paToken);
  if (list.ok) {
    scenariosLive = true;
    scenarios = list.data.map((r) => ({
      id: r.id,
      client_name: r.client_name ?? '—',
      country: r.country_name ?? '',
      provider: r.provider_name ?? '',
      version: String(r.version ?? '—'),
      total_pa_transactions:
        r.total_pa_transactions !== null && r.total_pa_transactions !== undefined
          ? Number(r.total_pa_transactions)
          : null,
      recommended_plan: r.recommended_plan_name ?? '—',
      total_cost:
        typeof r.recommended_total_annual_cost === 'number'
          ? r.recommended_total_annual_cost
          : Number(r.recommended_total_annual_cost ?? 0),
      has_summary: Boolean(r.has_summary),
      created_at:
        typeof r.created_at === 'string' ? r.created_at : new Date().toISOString(),
      created_by: r.created_by_email ?? undefined,
    }));
  } else {
    paNotice = `Plan Advisor unreachable (HTTP ${list.status}). Showing demo scenarios.`;
  }
}

const withSummary = scenarios.filter((s) => s.has_summary).length;
const withoutSummary = scenarios.filter((s) => !s.has_summary).length;

const byCountry: Record<string, ScenarioRow[]> = {};
for (const s of scenarios) {
  byCountry[s.country] ??= [];
  byCountry[s.country].push(s);
}

const paApiBaseForClient = planAdvisorApiBase();
const summaryListGenerateAuth =
  scenariosLive && paToken && paApiBaseForClient
    ? { bearer: paToken, apiKey: (import.meta.env.PA_PLAN_API_KEY ?? '').trim() }
    : null;

---
<UserLayout
  title="Scenarios"
  breadcrumbs={[{ label: 'Home', href: '/dashboard' }, { label: 'Scenarios' }]}
  paViewer={paViewer}
  paNotice={paNotice}
>
  <div class="page-scenarios-index">
  <!-- Header row -->
  <div class="page-header">
    <div>
      <h2 class="page-heading">{isInternal ? 'All Scenarios' : 'My Scenarios'}</h2>
      <p class="page-sub">
        {isInternal
          ? 'All calculation scenarios created by the team.'
          : 'Your saved PA plan calculations.'}
      </p>
    </div>
    <a href="/countries" class="btn-new">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      New Calculation
    </a>
  </div>

  <!-- Stats row -->
  <div class="stats-row">
    <div class="stat-card">
      <p class="stat-val">{scenarios.length}</p>
      <p class="stat-label">Total Scenarios</p>
    </div>
    <div class="stat-card">
      <p class="stat-val green">{withSummary}</p>
      <p class="stat-label">With AI Summary</p>
    </div>
    <div class="stat-card">
      <p class="stat-val amber">{withoutSummary}</p>
      <p class="stat-label">Pending Summary</p>
    </div>
    <div class="stat-card">
      <p class="stat-val">{Object.keys(byCountry).length}</p>
      <p class="stat-label">Countries</p>
    </div>
  </div>

  <!-- Filter + search -->
  <div class="filter-row">
    <div class="filter-tabs" id="filter-tabs">
      <button class="ftab active" data-filter="all">All <span class="ftab-count">{scenarios.length}</span></button>
      <button class="ftab" data-filter="has_summary">Has Summary <span class="ftab-count">{withSummary}</span></button>
      <button class="ftab" data-filter="no_summary">No Summary <span class="ftab-count">{withoutSummary}</span></button>
    </div>
    <div class="search-wrap">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input type="search" id="search-input" class="search-input" placeholder="Search client, country…" />
    </div>
  </div>

  <!-- Scenarios table -->
  {scenarios.length === 0 ? (
    <div class="empty-state">
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="16" y1="13" x2="8" y2="13"/>
        <line x1="16" y1="17" x2="8" y2="17"/>
      </svg>
      <p>No scenarios yet.</p>
      <a href="/countries" class="empty-cta">Start your first calculation →</a>
    </div>
  ) : (
    <div class="table-wrap" id="scenarios-table-wrap" data-scenarios-live={scenariosLive ? '1' : '0'}>
      <table class="table" id="scenarios-table">
        <thead>
          <tr>
            <th>Client</th>
            <th>Country / Provider</th>
            <th>Version</th>
            <th class="num">PA Transactions</th>
            <th>Recommended Plan</th>
            <th class="num">Annual Cost</th>
            <th>Summary</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {scenarios.map(s => (
            <tr
              data-summary={s.has_summary ? 'has_summary' : 'no_summary'}
              data-search={`${s.client_name} ${s.country} ${s.provider}`.toLowerCase()}
            >
              <td>
                <p class="client-name">{s.client_name}</p>
                {isInternal && s.created_by && (
                  <p class="created-by">by {s.created_by}</p>
                )}
              </td>
              <td>
                <div class="country-cell">
                  <span class="country-code">{(s.country || '??').slice(0, 2).toUpperCase()}</span>
                  <div>
                    <p class="country-name">{s.country}</p>
                    <p class="provider-name">{s.provider}</p>
                  </div>
                </div>
              </td>
              <td><span class="version-pill">{s.version}</span></td>
              <td class="num muted">{s.total_pa_transactions != null ? s.total_pa_transactions.toLocaleString() : '—'}</td>
              <td>
                <span class="plan-pill">{s.recommended_plan}</span>
              </td>
              <td class="num">
                <strong>€{s.total_cost.toLocaleString()}</strong>
              </td>
              <td>
                {s.has_summary
                  ? <span class="summary-badge yes">
                      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      Ready
                    </span>
                  : <span class="summary-badge no">Pending</span>
                }
              </td>
              <td class="muted date-cell">{formatScenarioTableDate(s.created_at)}</td>
              <td>
                <div class="action-row">
                  <a href={`/scenarios/${s.id}`} class="btn-view">View</a>
                  {!s.has_summary && (
                    <button type="button" class="btn-gen-summary js-gen-summary" data-scenario-id={s.id}>
                      AI Summary
                    </button>
                  )}
                  {scenariosLive ? (
                    <button
                      type="button"
                      class="btn-icon js-export-scenario"
                      title="Download scenario (JSON)"
                      data-scenario-id={s.id}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                      </svg>
                    </button>
                  ) : (
                    <button type="button" class="btn-icon" disabled title="Available when signed in to Plan Advisor">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                      </svg>
                    </button>
                  )}
                  {scenariosLive ? (
                    <button
                      type="button"
                      class="btn-icon btn-danger js-delete-scenario"
                      title="Delete scenario"
                      data-scenario-id={s.id}
                      data-client-name={s.client_name}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                        <path d="M10 11v6"/><path d="M14 11v6"/>
                        <path d="M9 6V4h6v2"/>
                      </svg>
                    </button>
                  ) : (
                    <button type="button" class="btn-icon btn-danger" disabled title="Available when signed in to Plan Advisor">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                        <path d="M10 11v6"/><path d="M14 11v6"/>
                        <path d="M9 6V4h6v2"/>
                      </svg>
                    </button>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <!-- Bulk actions footer (shown when rows are selected - TODO with checkbox logic) -->
  <div class="bulk-bar" id="bulk-bar" style="display:none">
    <span class="bulk-count" id="bulk-count">0 selected</span>
    <!-- TODO: POST /scenarios/bulk-summary → bulk generate summaries -->
    <button class="bulk-btn" onclick="alert('TODO: POST /scenarios/bulk-summary')">Generate Summaries</button>
    <!-- TODO: POST /scenarios/bulk-export -->
    <button class="bulk-btn" onclick="alert('TODO: POST /scenarios/bulk-export?format=pdf')">Export Selected</button>
  </div>

  <ScenarioDeleteModal />
  </div>
</UserLayout>

<script define:vars={{ paApiBaseForClient, summaryListGenerateAuth }}>
  const tabs   = document.querySelectorAll<HTMLButtonElement>('.ftab');
  const rows   = document.querySelectorAll<HTMLTableRowElement>('#scenarios-table tbody tr');
  const search = document.getElementById('search-input') as HTMLInputElement | null;

  let activeFilter = 'all';
  let searchQuery  = '';

  function applyFilters() {
    rows.forEach(row => {
      const sumAttr   = row.dataset.summary ?? '';
      const term      = row.dataset.search ?? '';
      const matchF    = activeFilter === 'all' || sumAttr === activeFilter;
      const matchS    = term.includes(searchQuery);
      row.style.display = matchF && matchS ? '' : 'none';
    });
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      activeFilter = tab.dataset.filter ?? 'all';
      applyFilters();
    });
  });

  if (search) {
    search.addEventListener('input', () => {
      searchQuery = search.value.toLowerCase();
      applyFilters();
    });
  }

  function planAdvisorScenarioGenerateSummaryUrl(scenarioId: string): string | null {
    const base = paApiBaseForClient.trim().replace(/\/$/, '');
    if (!base) return null;
    const b = base.replace(/\b0\.0\.0\.0\b/g, '127.0.0.1');
    const suffix = `/scenarios/${encodeURIComponent(scenarioId)}/generate-summary`;
    if (/\/api$/i.test(b)) return `${b}${suffix}`;
    return `${b}/api${suffix}`;
  }

  document.querySelectorAll<HTMLButtonElement>('.js-gen-summary').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-scenario-id');
      if (!id) return;
      const auth = summaryListGenerateAuth as { bearer: string; apiKey: string } | null;
      const url = planAdvisorScenarioGenerateSummaryUrl(id);
      if (!auth || !url) {
        alert('Configure Supabase + API_BASE_URL and load live scenarios to generate summaries.');
        return;
      }
      btn.disabled = true;
      const prev = btn.textContent;
      btn.textContent = '…';
      try {
        const headers: Record<string, string> = {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${auth.bearer}`,
        };
        if (auth.apiKey) headers['X-API-Key'] = auth.apiKey;

        const res = await fetch(url, {
          method: 'POST',
          headers,
          body: '{}',
          mode: 'cors',
        });
        const data = (await res.json().catch(() => ({}))) as Record<string, unknown>;
        if (!res.ok) {
          const msg =
            typeof data.message === 'string'
              ? data.message
              : typeof data.error === 'string'
                ? data.error
                : JSON.stringify(data);
          alert(`Summary failed (${res.status}): ${msg}`);
          btn.disabled = false;
          btn.textContent = prev ?? 'AI Summary';
          return;
        }
        window.location.reload();
      } catch {
        alert(
          'Summary request failed. Check CORS (FRONTEND_URL on Plan Advisor), SUMMARY_AGENT_URL, and try again.',
        );
        btn.disabled = false;
        btn.textContent = prev ?? 'AI Summary';
      }
    });
  });

  async function downloadScenarioJson(id: string) {
    const res = await fetch(
      `/api/pa/scenarios/${encodeURIComponent(id)}/export?format=json`,
      { credentials: 'same-origin' },
    );
    if (!res.ok) {
      const data = (await res.json().catch(() => ({}))) as Record<string, unknown>;
      const msg =
        typeof data.message === 'string'
          ? data.message
          : typeof data.error === 'string'
            ? data.error
            : `HTTP ${res.status}`;
      alert(`Download failed: ${msg}`);
      return;
    }
    const blob = await res.blob();
    const cd = res.headers.get('Content-Disposition');
    let safeName = `scenario-${id.slice(0, 8)}.json`;
    const quoted = cd && /filename="([^"]+)"/.exec(cd);
    if (quoted) safeName = quoted[1] ?? safeName;
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = safeName;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  document.querySelectorAll<HTMLButtonElement>('.js-export-scenario').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-scenario-id');
      if (!id) return;
      void downloadScenarioJson(id);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.js-delete-scenario').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-scenario-id');
      if (!id) return;
      const clientName = btn.getAttribute('data-client-name') ?? undefined;
      const w = window as Window & {
        paScenarioDeleteConfirm?: (opts?: { clientName?: string }) => Promise<boolean>;
        paScenarioDialogAlert?: (message: string) => Promise<void>;
      };
      const ok =
        typeof w.paScenarioDeleteConfirm === 'function'
          ? await w.paScenarioDeleteConfirm({ clientName })
          : window.confirm('Delete this scenario permanently? This cannot be undone.');
      if (!ok) return;
      btn.disabled = true;
      try {
        const res = await fetch(`/api/pa/scenarios/${encodeURIComponent(id)}`, {
          method: 'DELETE',
          credentials: 'same-origin',
        });
        if (res.status === 204) {
          window.location.reload();
          return;
        }
        const data = (await res.json().catch(() => ({}))) as Record<string, unknown>;
        const msg =
          typeof data.message === 'string'
            ? data.message
            : typeof data.error === 'string'
              ? data.error
              : JSON.stringify(data);
        const detail = `Delete failed (${res.status}): ${msg}`;
        if (typeof w.paScenarioDialogAlert === 'function') await w.paScenarioDialogAlert(detail);
        else alert(detail);
        btn.disabled = false;
      } catch {
        if (typeof w.paScenarioDialogAlert === 'function') {
          await w.paScenarioDialogAlert(
            'Delete request failed. Check your connection and try again.',
          );
        } else {
          alert('Delete request failed. Check your connection and try again.');
        }
        btn.disabled = false;
      }
    });
  });
</script>

