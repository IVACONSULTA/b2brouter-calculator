---
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../lib/session';

const session = getSession(Astro.cookies);
if (!session || session.role !== 'customer') {
  return Astro.redirect('/customer/login');
}
---

<Layout title="Customer Dashboard">
  <div class="app">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
          </svg>
          <span>My Account</span>
        </div>
      </div>

      <nav class="sidebar-nav">
        <a href="#" class="nav-item active">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"/>
            <rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/>
          </svg>
          Dashboard
        </a>
        <a href="#" class="nav-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12h18M3 6h18M3 18h18"/>
          </svg>
          My Routes
        </a>
        <a href="#" class="nav-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="5" width="20" height="14" rx="2"/>
            <line x1="2" y1="10" x2="22" y2="10"/>
          </svg>
          Billing
        </a>
        <a href="#" class="nav-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
          Calculator
        </a>
      </nav>

      <div class="sidebar-footer">
        <div class="user-info">
          <div class="avatar customer">{session.name.charAt(0)}</div>
          <div class="user-details">
            <span class="user-name">{session.name}</span>
            <span class="user-role">Customer</span>
          </div>
        </div>
        <form action="/api/auth/logout" method="POST">
          <button type="submit" class="logout-btn" title="Sign out">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
          </button>
        </form>
      </div>
    </aside>

    <div class="main-content">
      <header class="topbar">
        <div>
          <h1>Dashboard</h1>
          <p class="breadcrumb">Welcome back, {session.name}</p>
        </div>
      </header>

      <div class="content">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-icon customer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12h18M3 6h18M3 18h18"/>
              </svg>
            </div>
            <div class="stat-info">
              <span class="stat-value">8</span>
              <span class="stat-label">Active Routes</span>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon customer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
              </svg>
            </div>
            <div class="stat-info">
              <span class="stat-value">4,218</span>
              <span class="stat-label">Calls This Month</span>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon customer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"/>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </div>
            <div class="stat-info">
              <span class="stat-value">$482.60</span>
              <span class="stat-label">Current Balance</span>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon customer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 8v4l3 3"/>
              </svg>
            </div>
            <div class="stat-info">
              <span class="stat-value">May 1</span>
              <span class="stat-label">Next Invoice</span>
            </div>
          </div>
        </div>

        <div class="section-grid">
          <div class="panel">
            <div class="panel-header">
              <h3>My Routes</h3>
            </div>
            <ul class="route-list">
              {[
                { route: 'DE → FR', status: 'active', calls: '1,240' },
                { route: 'US → EU', status: 'active', calls: '980' },
                { route: 'UK → US', status: 'active', calls: '710' },
                { route: 'ES → LATAM', status: 'inactive', calls: '0' },
              ].map((r) => (
                <li class="route-item">
                  <span class="route-name">{r.route}</span>
                  <span class={`route-status ${r.status}`}>{r.status}</span>
                  <span class="route-calls">{r.calls} calls</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="panel">
            <div class="panel-header">
              <h3>Recent Invoices</h3>
            </div>
            <ul class="invoice-list">
              {[
                { period: 'April 2026', amount: '$482.60', status: 'pending' },
                { period: 'March 2026', amount: '$391.20', status: 'paid' },
                { period: 'February 2026', amount: '$445.80', status: 'paid' },
                { period: 'January 2026', amount: '$312.40', status: 'paid' },
              ].map((inv) => (
                <li class="invoice-item">
                  <span class="invoice-period">{inv.period}</span>
                  <span class="invoice-amount">{inv.amount}</span>
                  <span class={`invoice-status ${inv.status}`}>{inv.status}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .app {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  /* Sidebar */
  .sidebar {
    width: 240px;
    flex-shrink: 0;
    background: var(--color-surface);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }

  .sidebar-header {
    margin-bottom: 2rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-customer);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: all 0.15s ease;
  }

  .nav-item:hover {
    background: var(--color-surface-2);
    color: var(--color-text);
  }

  .nav-item.active {
    background: var(--color-customer-soft);
    color: var(--color-customer);
  }

  .sidebar-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .user-info {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1;
    min-width: 0;
  }

  .avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .avatar.customer {
    background: var(--color-customer-soft);
    color: var(--color-customer);
  }

  .user-details {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .user-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .user-role {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .logout-btn {
    background: none;
    border: none;
    color: var(--color-text-muted);
    padding: 0.4rem;
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
  }

  .logout-btn:hover {
    background: var(--color-surface-2);
    color: var(--color-text);
  }

  /* Main content */
  .main-content {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .topbar {
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .topbar h1 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .breadcrumb {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: 0.15rem;
  }

  .content {
    padding: 2rem;
    flex: 1;
  }

  /* Stats */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 1100px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .stat-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .stat-icon {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .stat-icon.customer {
    background: var(--color-customer-soft);
    color: var(--color-customer);
  }

  .stat-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .stat-value {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  /* Section grid */
  .section-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .section-grid { grid-template-columns: 1fr; }
  }

  .panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .panel-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .panel-header h3 {
    font-size: 0.9rem;
    font-weight: 600;
  }

  /* Route list */
  .route-list {
    list-style: none;
    padding: 0.5rem 0;
  }

  .route-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1.25rem;
    transition: background 0.15s;
  }

  .route-item:hover {
    background: var(--color-surface-2);
  }

  .route-name {
    flex: 1;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .route-status {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
  }

  .route-status.active {
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-customer);
  }

  .route-status.inactive {
    background: var(--color-surface-2);
    color: var(--color-text-muted);
  }

  .route-calls {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    width: 70px;
    text-align: right;
  }

  /* Invoice list */
  .invoice-list {
    list-style: none;
    padding: 0.5rem 0;
  }

  .invoice-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1.25rem;
    transition: background 0.15s;
  }

  .invoice-item:hover {
    background: var(--color-surface-2);
  }

  .invoice-period {
    flex: 1;
    font-size: 0.85rem;
  }

  .invoice-amount {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .invoice-status {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
    width: 60px;
    text-align: center;
  }

  .invoice-status.paid {
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-customer);
  }

  .invoice-status.pending {
    background: rgba(245, 158, 11, 0.1);
    color: var(--color-accent);
  }
</style>
