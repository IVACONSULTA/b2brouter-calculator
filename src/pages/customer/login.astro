---
import Layout from '../../layouts/Layout.astro';
import { getSession, canAccessUserPortal } from '../../lib/session';
import '../../styles/pages/customer-login.css';

const session = getSession(Astro.cookies);
if (session) {
  if (canAccessUserPortal(session.role)) return Astro.redirect('/dashboard');
  return Astro.redirect('/admin/dashboard');
}

const errorMessages: Record<string, string> = {
  invalid_credentials:
    'Incorrect email or password, or no user in this Supabase project. Reset the password under Supabase Dashboard → Authentication.',
  email_not_confirmed:
    'Confirm your email first, or adjust Supabase Auth email confirmation settings.',
  missing_fields: 'Please enter your email and password.',
  wrong_portal:
    'This portal is for internal users and clients. Administrators should use the Admin Portal.',
  server_config:
    'Server misconfiguration: SUPABASE_ANON_KEY is missing. Ask your admin to set SUPABASE_ANON_KEY in Netlify for all deploy contexts.',
  server_error: 'Something went wrong while signing in. Please try again later.',
};

const errorKey = Astro.url.searchParams.get('error') ?? '';
const errorMsg = errorMessages[errorKey] ?? '';

const isDemoMode =
  import.meta.env.SUPABASE_URL === 'https://placeholder.supabase.co' || !import.meta.env.SUPABASE_URL;
---

<Layout title="Customer sign in">
  <main class="page-customer-login login-page">
    <div class="login-card">
      <div class="login-header">
        <div class="icon customer">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
          </svg>
        </div>
        <div>
          <h1>Customer Portal</h1>
          <p>Internal team and client accounts (<code>internal</code> / <code>client</code> in profiles)</p>
        </div>
      </div>

      <div class="divider"></div>

      {isDemoMode && (
        <div class="demo-banner">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          <div><strong>Demo mode</strong> — use analyst or client demo accounts.</div>
        </div>
      )}

      {errorMsg && (
        <div class="error-banner">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          {errorMsg}
        </div>
      )}

      <form action="/api/auth/login?from=customer" method="POST" class="login-form" id="login-form">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="you@company.com" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="••••••••" autocomplete="current-password" required />
        </div>
        <button type="submit" class="btn-submit" id="btn-submit">
          <span class="btn-submit-text">Sign in</span>
        </button>
      </form>

      {isDemoMode && (
        <div class="demo-accounts">
          <p class="demo-accounts-title">Demo accounts</p>
          <div class="demo-list">
            <button type="button" class="demo-btn" data-email="analyst@b2brouter.com">
              <span class="demo-dot dot-internal"></span><span class="demo-email">analyst@b2brouter.com</span><span class="demo-role">Internal</span>
            </button>
            <button type="button" class="demo-btn" data-email="client@acmecorp.com">
              <span class="demo-dot dot-client"></span><span class="demo-email">client@acmecorp.com</span><span class="demo-role">Client</span>
            </button>
          </div>
        </div>
      )}

      <div class="back-link"><a href="/">← Back to portal selection</a></div>
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll('.demo-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const email = (btn as HTMLElement).dataset.email!;
      (document.getElementById('email') as HTMLInputElement).value = email;
      (document.getElementById('password') as HTMLInputElement).value = 'demo1234';
    });
  });
  document.getElementById('login-form')?.addEventListener('submit', () => {
    const b = document.getElementById('btn-submit') as HTMLButtonElement;
    const label = b.querySelector('.btn-submit-text');
    if (label) label.textContent = 'Signing in…';
    b.disabled = true;
  });
</script>

