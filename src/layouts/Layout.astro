---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — B2B Router Calculator</title>
    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --color-bg: #0f1117;
        --color-surface: #1a1d27;
        --color-surface-2: #242736;
        --color-border: #2e3347;
        --color-text: #e2e8f0;
        --color-text-muted: #8892a4;
        --color-admin: #6366f1;
        --color-admin-hover: #4f52d9;
        --color-admin-soft: rgba(99, 102, 241, 0.12);
        --color-customer: #10b981;
        --color-customer-hover: #059669;
        --color-customer-soft: rgba(16, 185, 129, 0.12);
        --color-accent: #f59e0b;
        --radius: 12px;
        --radius-sm: 8px;
      }

      html, body {
        height: 100%;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        cursor: pointer;
        font-family: inherit;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
