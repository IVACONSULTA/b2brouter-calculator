---
import Layout from './Layout.astro';
import { getSession } from '../lib/session';

interface Props {
  title: string;
  breadcrumbs?: { label: string; href?: string }[];
  /** Optional hydrated from `GET /api/me` — shown in sidebar instead of stale session-only values. */
  paViewer?: { displayName: string; subtitle: string } | null;
  /** Short banner under nav when live API unavailable (dummy login, missing env, errors). */
  paNotice?: string | null;
}

const { title, breadcrumbs = [], paViewer = null, paNotice = null } = Astro.props;
const session = getSession(Astro.cookies);
const path = Astro.url.pathname;

const role = session?.role ?? 'client';
const isInternal = role === 'internal';

const displayName =
  paViewer?.displayName?.trim() || session?.name?.trim() || 'User';
const subtitle =
  paViewer?.subtitle?.trim() || session?.email || '—';

function isActive(href: string, exact = false) {
  return exact ? path === href : path.startsWith(href);
}
---

<Layout title={title}>
  <div class="user-app" data-role={role}>
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-top">
        <div class="brand">
          <div class="brand-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <div class="brand-text">
            <span class="brand-name">PA Plan Advisor</span>
            <span class={`brand-role role-${role}`}>
              {role === 'internal' ? 'Internal' : role === 'admin' ? 'Admin' : 'Customer'}
            </span>
          </div>
        </div>

        <nav class="nav">
          {paNotice && (
            <div class="pa-banner" role="status">
              {paNotice}
            </div>
          )}
          <a href="/dashboard" class:list={['nav-item', { active: isActive('/dashboard', true) }]}>
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
              <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
            </svg>
            Dashboard
          </a>

          <a href="/countries" class:list={['nav-item', { active: isActive('/countries') }]}>
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            Countries
          </a>

          <a href="/scenarios" class:list={['nav-item', { active: isActive('/scenarios') }]}>
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
            My Scenarios
          </a>
        </nav>

      </div>

      <div class="sidebar-bottom">
        <div class="user-card">
          <div class={`user-avatar ua-${role}`}>{displayName.charAt(0).toUpperCase()}</div>
          <div class="user-info">
            <span class="user-name">{displayName}</span>
            <span class="user-email">{subtitle}</span>
          </div>
          <form action="/api/auth/logout" method="POST">
            <input type="hidden" name="from" value="customer" />
            <button type="submit" class="logout-btn" title="Sign out" aria-label="Sign out">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </aside>

    <!-- Main -->
    <div class="main-wrapper">
      <header class="topbar">
        <div class="topbar-left">
          <h1 class="page-title">{title}</h1>
          {breadcrumbs.length > 0 && (
            <nav class="breadcrumbs" aria-label="Breadcrumb">
              {breadcrumbs.map((crumb, i) => (
                <>
                  {i > 0 && <span class="bc-sep">/</span>}
                  {crumb.href
                    ? <a href={crumb.href} class="bc-link">{crumb.label}</a>
                    : <span class="bc-current">{crumb.label}</span>
                  }
                </>
              ))}
            </nav>
          )}
        </div>
        <div class="topbar-right">
          <a href="/countries" class="btn-calc">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            New Calculation
          </a>
        </div>
      </header>

      <main class="page-content">
        <slot />
      </main>
    </div>
  </div>
</Layout>

<style>
  .user-app {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    background: var(--color-bg);
  }

  /* ── Sidebar ── */
  .sidebar {
    width: 228px;
    flex-shrink: 0;
    background: var(--color-surface);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .sidebar-top {
    flex: 1;
    padding: 1.1rem 0.85rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0 0.25rem;
    margin-bottom: 1.6rem;
  }

  .brand-icon {
    width: 34px;
    height: 34px;
    background: var(--color-customer-soft);
    color: var(--color-customer);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  [data-role="internal"] .brand-icon {
    background: rgba(88,119,152,.12);
    color: var(--color-admin);
  }

  [data-role="admin"] .brand-icon {
    background: var(--color-admin-soft);
    color: var(--color-admin);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .brand-role {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .role-client   { color: var(--color-customer); }
  .role-internal { color: var(--color-admin); }
  .role-admin    { color: var(--color-admin); }

  .pa-banner {
    font-size: 0.68rem;
    line-height: 1.4;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border: 1px dashed var(--color-border);
    border-radius: 7px;
    padding: 0.45rem 0.55rem;
    margin-bottom: 0.65rem;
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 1.25rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.52rem 0.65rem;
    border-radius: 7px;
    font-size: 0.845rem;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: all 0.13s ease;
  }

  .nav-item:hover {
    background: var(--color-surface-2);
    color: var(--color-text);
  }

  .nav-item.active {
    background: var(--color-customer-soft);
    color: var(--color-customer);
    font-weight: 600;
  }

  [data-role="internal"] .nav-item.active {
    background: rgba(88,119,152,.12);
    color: var(--color-admin);
  }

  [data-role="admin"] .nav-item.active {
    background: var(--color-admin-soft);
    color: var(--color-admin);
  }

  /* ── Sidebar bottom ── */
  .sidebar-bottom {
    padding: 0.75rem 0.85rem;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .user-card {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .user-avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.78rem;
    font-weight: 700;
    flex-shrink: 0;
    background: var(--color-customer-soft);
    color: var(--color-customer);
  }

  .ua-internal { background: rgba(88,119,152,.12); color: var(--color-admin); }
  .ua-admin    { background: var(--color-admin-soft); color: var(--color-admin); }

  .user-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .user-name {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }

  .user-email {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .logout-btn {
    background: none;
    border: none;
    color: var(--color-text-muted);
    padding: 0.3rem;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.13s;
    display: flex;
  }

  .logout-btn:hover {
    background: var(--color-surface-2);
    color: var(--color-text);
  }

  /* ── Main wrapper ── */
  .main-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.75rem;
    height: 58px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    flex-shrink: 0;
    gap: 1rem;
  }

  .topbar-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
  }

  .page-title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .bc-sep { opacity: 0.4; }
  .bc-link { color: var(--color-text-muted); transition: color 0.13s; }
  .bc-link:hover { color: var(--color-text); }
  .bc-current { color: var(--color-text-muted); }

  .topbar-right { flex-shrink: 0; }

  .btn-calc {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    background: var(--color-customer);
    color: #fff;
    border-radius: 7px;
    font-size: 0.82rem;
    font-weight: 600;
    transition: all 0.13s ease;
    white-space: nowrap;
  }

  .btn-calc:hover {
    background: var(--color-customer-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(51, 70, 90, 0.22);
  }

  [data-role="internal"] .btn-calc { background: var(--color-admin); }
  [data-role="internal"] .btn-calc:hover { background: var(--color-admin-hover); box-shadow: 0 4px 16px rgba(88,119,152,.3); }

  .page-content {
    flex: 1;
    overflow-y: auto;
    padding: 1.75rem;
  }
</style>
