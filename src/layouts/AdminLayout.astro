---
import Layout from './Layout.astro';
import { getSession } from '../lib/session';

interface Props {
  title: string;
  breadcrumbs?: { label: string; href?: string }[];
  /** Inline status (e.g. API configuration hints). */
  notice?: string | null;
}

const { title, breadcrumbs = [], notice = null } = Astro.props;
const session = getSession(Astro.cookies);
const path = Astro.url.pathname;

function isActive(href: string, exact = false) {
  return exact ? path === href : path.startsWith(href);
}
---

<Layout title={title}>
  <div class="admin-app">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-top">
        <div class="brand">
          <div class="brand-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <div class="brand-text">
            <span class="brand-name">PA Plan Advisor</span>
            <span class="brand-role">Admin</span>
          </div>
        </div>

        <nav class="nav">
          <span class="nav-section-label">Workspace</span>

          <a href="/admin/dashboard" class:list={['nav-item', { active: isActive('/admin/dashboard', true) }]}>
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
              <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
            </svg>
            Dashboard
          </a>

          <a href="/countries" class:list={['nav-item', { active: isActive('/countries') }]}>
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            Countries & Providers
          </a>

          <a href="/admin/analyses" class:list={['nav-item', { active: isActive('/admin/analyses') }]}>
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/>
            </svg>
            AI Analyses
            <span class="nav-badge">2</span>
          </a>

          <span class="nav-section-label" style="margin-top: 0.5rem">Calculate</span>

          <a href="/scenarios" class:list={['nav-item', { active: isActive('/scenarios') }]}>
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
            Scenarios
          </a>

          <span class="nav-section-label" style="margin-top: 0.5rem">Admin</span>

          <a href="/admin/settings" class:list={['nav-item', { active: isActive('/admin/settings', true) }]}>
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
            Settings & Users
          </a>
        </nav>
      </div>

      <div class="sidebar-bottom">
        <div class="user-card">
          <div class="user-avatar">{session?.name?.charAt(0) ?? 'A'}</div>
          <div class="user-info">
            <span class="user-name">{session?.name ?? 'Admin User'}</span>
            <span class="user-email">{session?.email ?? 'admin@example.com'}</span>
          </div>
          <form action="/api/auth/logout" method="POST">
            <button type="submit" class="logout-btn" title="Sign out">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </aside>

    <!-- Main -->
    <div class="main-wrapper">
      <header class="topbar">
        <div class="topbar-left">
          <h1 class="page-title">{title}</h1>
          {breadcrumbs.length > 0 && (
            <nav class="breadcrumbs" aria-label="Breadcrumb">
              {breadcrumbs.map((crumb, i) => (
                <>
                  {i > 0 && <span class="bc-sep">/</span>}
                  {crumb.href
                    ? <a href={crumb.href} class="bc-link">{crumb.label}</a>
                    : <span class="bc-current">{crumb.label}</span>
                  }
                </>
              ))}
            </nav>
          )}
        </div>
        <div class="topbar-right">
          <a href="/admin/countries/new" class="btn-new">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            New Country
          </a>
        </div>
      </header>

      <main class="page-content">
        {notice && (
          <div class="admin-notice" role="status">{notice}</div>
        )}
        <slot />
      </main>
    </div>
  </div>
</Layout>

<style>
  .admin-notice {
    margin-bottom: 1rem;
    padding: 0.65rem 0.9rem;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.28);
    border-radius: 8px;
  }

  .admin-app {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    background: var(--color-bg);
  }

  /* ── Sidebar ── */
  .sidebar {
    width: 228px;
    flex-shrink: 0;
    background: var(--color-surface);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .sidebar-top {
    flex: 1;
    padding: 1.1rem 0.85rem 0.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0 0.25rem;
    margin-bottom: 1.6rem;
  }

  .brand-icon {
    width: 34px;
    height: 34px;
    background: var(--color-admin-soft);
    color: var(--color-admin);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .brand-role {
    font-size: 0.68rem;
    color: var(--color-admin);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-section-label {
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: 0 0.5rem;
    margin-top: 1rem;
    margin-bottom: 2px;
    display: block;
    opacity: 0.6;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.52rem 0.65rem;
    border-radius: 7px;
    font-size: 0.845rem;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: all 0.13s ease;
    position: relative;
  }

  .nav-item:hover {
    background: var(--color-surface-2);
    color: var(--color-text);
  }

  .nav-item.active {
    background: var(--color-admin-soft);
    color: var(--color-admin);
    font-weight: 600;
  }

  .nav-badge {
    margin-left: auto;
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 100px;
  }

  /* ── Sidebar bottom ── */
  .sidebar-bottom {
    padding: 0.75rem 0.85rem;
    border-top: 1px solid var(--color-border);
  }

  .user-card {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .user-avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-admin-soft);
    color: var(--color-admin);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.78rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .user-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .user-name {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }

  .user-email {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .logout-btn {
    background: none;
    border: none;
    color: var(--color-text-muted);
    padding: 0.3rem;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.13s;
    display: flex;
  }

  .logout-btn:hover {
    background: var(--color-surface-2);
    color: var(--color-text);
  }

  /* ── Main wrapper ── */
  .main-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ── Topbar ── */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.75rem;
    height: 58px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    flex-shrink: 0;
    gap: 1rem;
  }

  .topbar-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
  }

  .page-title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .bc-sep {
    opacity: 0.4;
  }

  .bc-link {
    color: var(--color-text-muted);
    transition: color 0.13s;
  }

  .bc-link:hover {
    color: var(--color-text);
  }

  .bc-current {
    color: var(--color-text-muted);
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .btn-new {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    background: var(--color-admin);
    color: #fff;
    border-radius: 7px;
    font-size: 0.82rem;
    font-weight: 600;
    transition: all 0.13s ease;
    white-space: nowrap;
  }

  .btn-new:hover {
    background: var(--color-admin-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(88, 119, 152, 0.35);
  }

  /* ── Page content ── */
  .page-content {
    flex: 1;
    overflow-y: auto;
    padding: 1.75rem;
  }
</style>
