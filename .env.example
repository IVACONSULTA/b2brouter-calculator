# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.

# ── Local development (supabase start) ────────────────────────────────────────
# These values come from `supabase status` after running `supabase start`.
# Replace with cloud Supabase values for staging/production.
SUPABASE_URL=http://127.0.0.1:54321
# From `supabase status`: use "Publishable" (or legacy anon JWT).
SUPABASE_ANON_KEY=<publishable key from supabase status>

# From LOCAL Supabase only — NOT cloud. Best: run `supabase status -o env` and use SERVICE_ROLE_KEY=eyJ...
# (JWT). Do not use sb_publishable_; sb_secret_ can fail auth.admin with "User not allowed" on some CLI versions.
# Needed for: npm run seed:users , npm run sync:auth:prod-to-local
SUPABASE_SERVICE_ROLE_KEY=

# ── One-off: copy Auth users from CLOUD → local (`npm run sync:auth:prod-to-local`) ──
# You need TWO different sets of keys:
#   • LOCAL  → supabase status (Secret + URL above)
#   • CLOUD  → Supabase Dashboard → your project → Settings → API (NOT from CLI)
#
# Direct link pattern:  https://supabase.com/dashboard/project/<project-ref>/settings/api
# SUPABASE_PROD_URL=https://YOUR_PROJECT_REF.supabase.co
# Paste "service_role" here (reveal in dashboard). NOT the Publishable/anon key.
# SUPABASE_PROD_SERVICE_ROLE_KEY=
# SYNC_LOCAL_DEFAULT_PASSWORD=
# Optional: set to 1 to also reset passwords of users that already exist locally.
# RESET_LOCAL_PASSWORD=

# ── One-off: set passwords on LOCAL auth users (`npm run auth:set-local-passwords`) ──
# Remove these after running — do not commit real passwords.
# LOCAL_SET_PASSWORD=
# Optional; comma-separated. If omitted, every user with an email is updated.
# LOCAL_SET_PASSWORD_EMAILS=admin@example.com,client@example.com

# ── Optional: your own user on LOCAL Supabase only (`npm run seed:users`) ─────
# SEED_EXTRA_EMAIL=you@example.com
# SEED_EXTRA_PASSWORD=choose-a-strong-password
# SEED_EXTRA_ROLE=admin
# SEED_EXTRA_FULL_NAME=Your Name
API_BASE_URL=
# Same value as PA_PLAN_API_KEY on the Railway API service (optional locally if the API disables the key gate).
PA_PLAN_API_KEY=
