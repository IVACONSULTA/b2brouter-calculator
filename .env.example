# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.

# ── Local development (supabase start) ────────────────────────────────────────
# These values come from `supabase status` after running `supabase start`.
# Replace with cloud Supabase values for staging/production.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<paste anon key from `supabase status`>

# Service role key from `supabase status` — local only, never commit, never use in the browser.
# Needed for: npm run seed:users
SUPABASE_SERVICE_ROLE_KEY=

# ── Backend API (Railway) — leave blank until backend is deployed ──────────────
API_BASE_URL=
